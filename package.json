{
  "name": "@icen.ai/ui",
  "version": "0.6.0",
  "description": "Icen Design System — 设计 tokens（6 预设 × 明暗）、无框架组件 CSS 与行为 JS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icen-ai/ui.git"
  },
  "homepage": "https://ui.icen.ai",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./behaviors/*": "./dist/behaviors/*.mjs",
    "./kit/*": "./dist/components/*.mjs",
    "./tokens.css": "./dist/tokens.css",
    "./ui.css": "./dist/ui.css",
    "./base.css": "./dist/base.css",
    "./retro-effects.css": "./dist/retro-effects.css",
    "./tokens/*": "./dist/tokens/*",
    "./components/*": "./dist/components/*",
    "./registry.json": "./dist/registry.json"
  },
  "bin": {
    "icen-ui": "./dist/cli.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "AGENTS.md",
    "docs"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && bun scripts/build-css.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "design-system",
    "ai-components",
    "zero-dependency",
    "charts",
    "css",
    "tokens"
  ]
}
