{
  "name": "@icen.ai/ui",
  "version": "0.10.0",
  "description": "Icen Design System — 设计 tokens（8 主题 × 4 原语 × 明暗）+ 无框架组件 CSS/行为 JS + AI 原生组件族（7 态状态机/多模态/定价审计）+ 图表通用层（ChartSpec 纯 JSON）+ AI 工具体系",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icen-ai/ui.git"
  },
  "homepage": "https://ui.icen.ai",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./react": "./dist/react.mjs",
    "./vue": "./dist/vue.mjs",
    "./behaviors/*": "./dist/behaviors/*.mjs",
    "./kit/*": "./dist/components/*.mjs",
    "./tokens.css": "./dist/tokens.css",
    "./tokens/dtcg.json": "./dist/tokens/dtcg.json",
    "./ui.css": "./dist/ui.css",
    "./base.css": "./dist/base.css",
    "./tokens/*": "./dist/tokens/*",
    "./components/*": "./dist/components/*",
    "./registry.json": "./dist/registry.json"
  },
  "bin": {
    "icen-ui": "./dist/cli.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "docs/spec"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && bun scripts/react-use-client.mjs && bun scripts/dts-ext.mjs && bun scripts/build-css.ts && bun scripts/dtcg.mjs && bun scripts/design-tokens.mjs",
    "dtcg": "bun scripts/dtcg.mjs",
    "design-tokens": "bun scripts/design-tokens.mjs",
    "guard": "bun scripts/guard/index.ts",
    "contracts": "bun scripts/contracts.ts --check",
    "contracts:update": "bun scripts/contracts.ts --write",
    "prepublishOnly": "bun run build",
    "pretest:e2e": "cd site && bun run build",
    "test": "bun test",
    "test:e2e": "playwright test",
    "verify": "bunx tsc --noEmit && bun run guard && bun test && bun run build",
    "colors": "bun scripts/theme-colors.mjs"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vue": "^3.5.43"
  },
  "keywords": [
    "design-system",
    "ai-components",
    "zero-dependency",
    "charts",
    "css",
    "tokens"
  ]
}
