---
import Docs from '../../layouts/Docs.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PmInstall from '../../components/PmInstall.astro';
import { COMPONENTS, cssFor, tierOf, type ComponentDoc } from '../../lib/components';
import { inlineMd } from '../../lib/doc-text';
import { SLUGS } from '../../../../scripts/slugs.mjs';
import { slugApi } from '../../../../scripts/slug-api.mjs';
import { iconHTML } from '../../../../src/behaviors/icons';

export function getStaticPaths() {
  return COMPONENTS.map((doc, i) => ({
    params: { slug: doc.slug },
    props: { doc, prev: COMPONENTS[i - 1], next: COMPONENTS[i + 1] },
  }));
}

interface Props {
  doc: ComponentDoc;
  prev?: ComponentDoc;
  next?: ComponentDoc;
}
const { doc, prev, next } = Astro.props;
const lead = doc.summary ?? (doc.desc.length > 160 ? (doc.desc.match(/^(.{1,156}?)[。；]/)?.[0] ?? `${doc.desc.slice(0,156).trim()}…`) : doc.desc);

// kit 一行入口：CSS + behavior 自动带上。init 分两路：本组件模块的 init 走 kit 入口
// （kit 对 behaviors/<slug>.mjs 是 export *，必然可导）；跨模块 init（如 kb-canvas 页的
// ai-diff）只能从包根 import——拍平进 kit 行会生成复制即失败的 import
const ownInitRaw = doc.behaviorInit?.[doc.slug];
const ownInits = Array.isArray(ownInitRaw) ? ownInitRaw : ownInitRaw ? [ownInitRaw] : [];
const otherInits = Object.entries(doc.behaviorInit ?? {})
  .filter(([m]) => m !== doc.slug)
  .flatMap(([, v]) => (Array.isArray(v) ? v : v ? [v] : []));
const kitLines: string[] = [];
kitLines.push(
  ownInits.length
    ? `import { ${ownInits.join(', ')} } from '@icen.ai/ui/kit/${doc.slug}';`
    : `import '@icen.ai/ui/kit/${doc.slug}';`,
);
if (otherInits.length) kitLines.push(`import { ${otherInits.join(', ')} } from '@icen.ai/ui';`);
for (const f of [...ownInits, ...otherInits]) kitLines.push(`${f}();`);
const kitCode = kitLines.join('\n');
const cliCode = `bunx --bun @icen.ai/ui add ${doc.slug}`;
// 纯文档聚合页（如 ai-overview）不在 SLUGS——包内无 kit/<slug> 入口，安装三段不渲染
const isKit = SLUGS.includes(doc.slug);
// usage 以 import 开头视为 JS，否则按 HTML 高亮
const usageLang = /^\s*(import|const|\/\/)/.test(doc.usage) ? 'js' : 'html';
const pageLink = `[${doc.name} · ICEN UI](https://ui.icen.ai/components/${doc.slug}/)`;

/* 稳定性分层徽标：tierOf 单一实现（lib/components，事实源 docs/contracts/tiers.json） */
const docTier = tierOf(doc.slug, doc.group);

/* 接口区块：由 slugs.mjs 登记表 + 行为源码扫描自动生成（构建期），永不漂移 */
const api = isKit ? slugApi(doc.slug) : null;

const copySvg = iconHTML('copy',{size:13,className:'icen-copy-icon-clipboard'});
const checkSvg = iconHTML('check',{size:13,className:'icen-copy-icon-check'});
const leftSvg = iconHTML('chevron-left',{size:14});
const rightSvg = iconHTML('chevron-right',{size:14});

// 传给页面内联脚本的数据：< 转义防 </script> 提前闭合
const bootData = JSON.stringify({
  behaviors: doc.behaviors ?? [],
  init: doc.behaviorInit ?? {},
  script: doc.script ?? '',
}).replace(/</g, '\\u003c');
---
<Docs title={`${doc.name} · 组件 · ICEN UI`} description={doc.desc}>
  <div class="doc-head">
    <div class="doc-head-main">
      <div class="doc-crumb-row">
        <nav class="doc-crumb">组件 / {doc.group} / <span class="icen-mono">{doc.slug}</span></nav>
        <span class:list={['doc-tier', `doc-tier--${docTier}`]} title={docTier === 'beta' ? '演进层：随 minor 快速迭代，0.x 期间不保兼容' : '稳定层：1.0 冻结轨道，破坏性变更须公告'}>
          {docTier === 'beta' ? 'Beta · 演进中' : 'Core · 稳定'}
        </span>
      </div>
      <h1 class="doc-title">{doc.name}</h1>
      <p class="doc-desc"><bdi>{lead}</bdi></p>
    </div>
    <div class="doc-actions">
      <button class="doc-copy-page icen-copy-btn" type="button" data-icen-copy={pageLink} data-icen-copy-icon>
        <Fragment set:html={copySvg + checkSvg} />
        <span>复制当前页</span>
      </button>
      <a
        class:list={['doc-arrow', { 'is-disabled': !prev }]}
        href={prev ? `/components/${prev.slug}/` : '#'}
        aria-label={prev ? `上一个：${prev.name}` : '没有上一个'}
        aria-disabled={!prev}
      ><Fragment set:html={leftSvg} /></a>
      <a
        class:list={['doc-arrow', { 'is-disabled': !next }]}
        href={next ? `/components/${next.slug}/` : '#'}
        aria-label={next ? `下一个：${next.name}` : '没有下一个'}
        aria-disabled={!next}
      ><Fragment set:html={rightSvg} /></a>
    </div>
  </div>

  <section class="demo-panel">
    <div class="demo-stage" data-demo-layout={doc.demoLayout} set:html={doc.demo} />
    <CodeBlock code={doc.demo} lang="html" collapsible />
  </section>
  {doc.detail?.features?.length ? (
    <>
      <h2 class="doc-h2">特性</h2>
      <ul class="doc-feats">
        {doc.detail.features.map((f) => <li set:html={inlineMd(f)} />)}
      </ul>
    </>
  ) : null}
  {doc.detail?.notes?.length ? (
    <div class="doc-notes">
      {doc.detail.notes.map((n) => <p set:html={inlineMd(n)} />)}
    </div>
  ) : null}
  {!doc.detail && lead !== doc.desc && (
    <details class="doc-details">
      <summary>行为与接口说明 <Fragment set:html={iconHTML('chevron-down')} /></summary>
      <p>{doc.desc}</p>
    </details>
  )}

  {api && (api.exports.length > 0 || api.events.length > 0) && (
    <>
      <h2 class="doc-h2">接口</h2>
      <dl class="doc-api">
        {api.init && (
          <div class="doc-api-row">
            <dt>初始化</dt>
            <dd><code>{api.init}()</code><span class="doc-api-note">（kit 一行入口可直接命名导入）</span></dd>
          </div>
        )}
        {api.exports.length > 0 && (
          <div class="doc-api-row">
            <dt>导出</dt>
            <dd>
              {api.exports.map((e) => <code>{e}</code>)}
              {api.sharedModule && <span class="doc-api-note">共享行为模块，清单含族内导出</span>}
            </dd>
          </div>
        )}
        {api.events.length > 0 && (
          <div class="doc-api-row">
            <dt>事件</dt>
            <dd>
              {api.events.map((e) => <code>{e}</code>)}
              <span class="doc-api-note">
                detail 契约见 <code>IcenEventMap</code>{api.sharedModule ? '；共享行为模块，清单含族内事件' : ''}
              </span>
            </dd>
          </div>
        )}
        {api.behavior && (
          <div class="doc-api-row">
            <dt>类型</dt>
            <dd><code>dist/behaviors/{api.behavior}.d.mts</code><span class="doc-api-note">（随 npm 包发布，含全部 JSDoc 约束）</span></dd>
          </div>
        )}
      </dl>
    </>
  )}

  <h2 class="doc-h2">安装</h2>
  <PmInstall />
  {isKit && (
    <>
      <p class="doc-note">一行引入该组件（CSS 与 behavior 自动带上，无需关心内部 CSS 文件名）：</p>
      <CodeBlock code={kitCode} lang="js" />
      <p class="doc-note">也可以用脚手架直接打印引入行：</p>
      <CodeBlock code={cliCode} lang="bash" />
      <p class="doc-note doc-note--warn">
        Astro 项目注意：kit 入口里的 CSS import 在页面 <code>&lt;script&gt;</code> 里会被 Astro 的 client bundle 摇掉——请改在布局 frontmatter 里引 CSS（<code>import '@icen.ai/ui/components/{cssFor(doc.slug)}';</code>），JS 行为仍可走 kit。Vite SPA / webpack 项目无此问题。
      </p>
    </>
  )}

  <h2 class="doc-h2">用法</h2>
  <CodeBlock code={doc.usage} lang={usageLang} />

  <nav class="doc-pager">
    {prev ? (
      <a class="doc-pager-link" href={`/components/${prev.slug}/`}>
        <span class="doc-pager-label">上一个</span>
        <span class="doc-pager-name"><Fragment set:html={iconHTML('arrow-left',{size:14})} /> {prev.name}</span>
      </a>
    ) : <span />}
    {next ? (
      <a class="doc-pager-link doc-pager-next" href={`/components/${next.slug}/`}>
        <span class="doc-pager-label">下一个</span>
        <span class="doc-pager-name">{next.name} <Fragment set:html={iconHTML('arrow-right',{size:14})} /></span>
      </a>
    ) : <span />}
  </nav>

  <script type="application/json" id="doc-boot-data" set:html={bootData} />
  <script>
    import { initCopy } from '../../../../src/behaviors/copy.ts';
    import { initTooltip } from '../../../../src/behaviors/tooltip.ts';
    let bootGeneration = 0;
    let disposeDemo: (() => void) | undefined;
    function cleanupDemo(): void {
      bootGeneration++;
      disposeDemo?.();
      disposeDemo = undefined;
    }
    document.addEventListener('astro:before-swap', cleanupDemo);

    // astro:page-load = 首载 + 每次 ClientRouter 换页（模块脚本同 src 只评估一次，
    // 直接调用会在第二次换页后断线；copy 是事件委托幂等，重复调用安全）
    document.addEventListener('astro:page-load', () => {
      initCopy();
      initTooltip();
      void boot();
    });

    type BootData = {
      behaviors?: string[];
      /** 模块 → init 函数名（string 或 string[]：同一模块多个 init 依序执行） */
      init?: Record<string, string | string[]>;
      script?: string;
    };

    async function boot(): Promise<void> {
      cleanupDemo();
      const generation = bootGeneration;
      const el = document.getElementById('doc-boot-data');
      if (!el) return;
      const data = JSON.parse(el.textContent ?? '{}') as BootData;

      // 按需动态加载本组件页声明的 behavior 模块
      const mods = import.meta.glob('../../../../src/behaviors/*.ts');
      const loaded: Record<string, Record<string, unknown>> = {};
      for (const b of data.behaviors ?? []) {
        const load = mods[`../../../../src/behaviors/${b}.ts`];
        if (typeof load === 'function') {
          try {
            loaded[b] = (await load()) as Record<string, unknown>;
            if (generation !== bootGeneration || !el.isConnected) return;
          } catch (err) {
            console.error(`[docs] 加载 behavior 模块失败: ${b}`, err);
            throw err;
          }
        } else {
          console.error(`[docs] behavior 未登记到 glob：${b}（新增 behavior 文件后需重启 dev server 触发重转译）`);
        }
      }
      // 按注册表给出的 init 函数名初始化（accordion→initAccordion 等）
      for (const b of data.behaviors ?? []) {
        const initName = data.init?.[b];
        const names = Array.isArray(initName) ? initName : initName ? [initName] : [];
        for (const n of names) {
          const fn = loaded[b]?.[n];
          if (typeof fn === 'function') (fn as () => void)();
        }
      }
      // 额外接线脚本（charts 渲染数据、context-menu 注册、演示回显等），
      // 以 camelCase + 'Mod' 形参暴露各模块（context-menu → contextMenuMod）。
      // 硬约束：components.ts 的 script 字段必须是纯 JS（new Function 执行，禁 TS 语法）。
      if (data.script) {
        const keys = Object.keys(loaded);
        const names = keys.map(
          (b) => b.replace(/-([a-z])/g, (_m, c: string) => c.toUpperCase()) + 'Mod',
        );
        try {
          const fn = new Function(...names, data.script) as (...args: unknown[]) => unknown;
          const cleanup = fn(...keys.map((k) => loaded[k]));
          if (typeof cleanup === 'function') disposeDemo = cleanup as () => void;
        } catch (err) {
          console.error('[docs] 演示接线脚本执行失败', err);
          throw err;
        }
      }
      document.querySelector('.demo-stage')?.setAttribute('data-icen-demo-ready','');
    }
  </script>
</Docs>

<style is:global>
  .doc-note { font-size: 13px; color: var(--icen-token-text-muted); margin: 14px 0 10px; }
  .doc-note--warn {
    padding: 10px 14px;
    border-left: 2px solid var(--icen-token-warning);
    background: color-mix(in srgb, var(--icen-token-warning) 6%, transparent);
    border-radius: 0 var(--icen-radius-sm) var(--icen-radius-sm) 0;
    line-height: 1.7;
  }

  /* 稳定性分层徽标（数据源 docs/contracts/tiers.json，registry.tiers 同源盖章） */
  .doc-crumb-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .doc-tier {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border-radius: var(--icen-radius-full);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: help;
    border: 1px solid color-mix(in srgb, var(--icen-token-success) 45%, transparent);
    color: var(--icen-token-success);
    background: color-mix(in srgb, var(--icen-token-success) 8%, transparent);
  }
  .doc-tier--beta {
    border-color: color-mix(in srgb, var(--icen-token-warning) 45%, transparent);
    color: var(--icen-token-warning);
    background: color-mix(in srgb, var(--icen-token-warning) 8%, transparent);
  }

  .doc-pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--icen-token-line-soft);
  }
  .doc-pager-link { display: flex; flex-direction: column; gap: 2px; }
  .doc-pager-link:hover { text-decoration: none; }
  .doc-pager-link:hover .doc-pager-name { color: var(--icen-token-accent-deep, var(--icen-token-accent)); }
  .doc-pager-next { margin-left: auto; text-align: right; }
  .doc-pager-label { font-size: 11px; color: var(--icen-token-text-faint); letter-spacing: 1px; }
  .doc-pager-name { font-size: 14px; color: var(--icen-token-accent-text, var(--icen-token-accent)); font-weight: 500; }
</style>
