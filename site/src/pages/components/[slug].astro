---
import Docs from '../../layouts/Docs.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PmInstall from '../../components/PmInstall.astro';
import { COMPONENTS, cssFor, type ComponentDoc } from '../../lib/components';

export function getStaticPaths() {
  return COMPONENTS.map((doc, i) => ({
    params: { slug: doc.slug },
    props: { doc, prev: COMPONENTS[i - 1], next: COMPONENTS[i + 1] },
  }));
}

interface Props {
  doc: ComponentDoc;
  prev?: ComponentDoc;
  next?: ComponentDoc;
}
const { doc, prev, next } = Astro.props;

// kit 一行入口：CSS + behavior 自动带上；有 init 契约的组件给出初始化两行
const initFn = Object.values(doc.behaviorInit ?? {})[0];
const kitCode = initFn
  ? `import { ${initFn} } from '@icen.ai/ui/kit/${doc.slug}';\n${initFn}();`
  : `import '@icen.ai/ui/kit/${doc.slug}';`;
const cliCode = `bunx --bun @icen.ai/ui add ${doc.slug}`;
// usage 以 import 开头视为 JS，否则按 HTML 高亮
const usageLang = /^\s*(import|const|\/\/)/.test(doc.usage) ? 'js' : 'html';
const pageLink = `[${doc.name} · ICEN UI](https://ui.icen.ai/components/${doc.slug}/)`;

const copySvg = `<svg class="ic-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>`;
const checkSvg = `<svg class="ic-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
const leftSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>`;
const rightSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>`;

// 传给页面内联脚本的数据：< 转义防 </script> 提前闭合
const bootData = JSON.stringify({
  behaviors: doc.behaviors ?? [],
  init: doc.behaviorInit ?? {},
  script: doc.script ?? '',
}).replace(/</g, '\\u003c');
---
<Docs title={`${doc.name} · 组件 · ICEN UI`} description={doc.desc}>
  <div class="doc-head">
    <div class="doc-head-main">
      <nav class="doc-crumb">组件 / {doc.group} / <span class="mono">{doc.slug}</span></nav>
      <h1 class="doc-title">{doc.name}</h1>
      <p class="doc-desc">{doc.desc}</p>
    </div>
    <div class="doc-actions">
      <button class="doc-copy-page copy-btn" type="button" data-copy={pageLink} data-copy-icon>
        <Fragment set:html={copySvg + checkSvg} />
        <span>复制当前页</span>
      </button>
      <a
        class:list={['doc-arrow', { 'is-disabled': !prev }]}
        href={prev ? `/components/${prev.slug}/` : '#'}
        aria-label={prev ? `上一个：${prev.name}` : '没有上一个'}
        aria-disabled={!prev}
      ><Fragment set:html={leftSvg} /></a>
      <a
        class:list={['doc-arrow', { 'is-disabled': !next }]}
        href={next ? `/components/${next.slug}/` : '#'}
        aria-label={next ? `下一个：${next.name}` : '没有下一个'}
        aria-disabled={!next}
      ><Fragment set:html={rightSvg} /></a>
    </div>
  </div>

  <section class="demo-panel">
    <div class="demo-stage" set:html={doc.demo} />
    <CodeBlock code={doc.demo} lang="html" collapsible flat />
  </section>

  <h2 class="doc-h2">安装</h2>
  <PmInstall />
  <p class="doc-note">一行引入该组件（CSS 与 behavior 自动带上，无需关心内部 CSS 文件名）：</p>
  <CodeBlock code={kitCode} lang="js" />
  <p class="doc-note">也可以用脚手架直接打印引入行：</p>
  <CodeBlock code={cliCode} lang="bash" />
  <p class="doc-note doc-note--warn">
    Astro 项目注意：kit 入口里的 CSS import 在页面 <code>&lt;script&gt;</code> 里会被 Astro 的 client bundle 摇掉——请改在布局 frontmatter 里引 CSS（<code>import '@icen.ai/ui/components/{cssFor(doc.slug)}';</code>），JS 行为仍可走 kit。Vite SPA / webpack 项目无此问题。
  </p>

  <h2 class="doc-h2">用法</h2>
  <CodeBlock code={doc.usage} lang={usageLang} />

  <nav class="doc-pager">
    {prev ? (
      <a class="doc-pager-link" href={`/components/${prev.slug}/`}>
        <span class="doc-pager-label">上一个</span>
        <span class="doc-pager-name">← {prev.name}</span>
      </a>
    ) : <span />}
    {next ? (
      <a class="doc-pager-link doc-pager-next" href={`/components/${next.slug}/`}>
        <span class="doc-pager-label">下一个</span>
        <span class="doc-pager-name">{next.name} →</span>
      </a>
    ) : <span />}
  </nav>

  <script type="application/json" id="doc-boot-data" set:html={bootData} />
  <script>
    import { initCopy } from '../../../../src/behaviors/copy.ts';

    // 代码块复制按钮（.copy-btn[data-copy] 事件委托，幂等）
    initCopy();

    type BootData = {
      behaviors?: string[];
      init?: Record<string, string>;
      script?: string;
    };

    async function boot(): Promise<void> {
      const el = document.getElementById('doc-boot-data');
      if (!el) return;
      const data = JSON.parse(el.textContent ?? '{}') as BootData;

      // 按需动态加载本组件页声明的 behavior 模块
      const mods = import.meta.glob('../../../../src/behaviors/*.ts');
      const loaded: Record<string, Record<string, unknown>> = {};
      for (const b of data.behaviors ?? []) {
        const load = mods[`../../../../src/behaviors/${b}.ts`];
        if (typeof load === 'function') {
          try {
            loaded[b] = (await load()) as Record<string, unknown>;
          } catch (err) {
            console.error(`[docs] 加载 behavior 模块失败: ${b}`, err);
            throw err;
          }
        }
      }
      // 按注册表给出的 init 函数名初始化（accordion→initAccordion 等）
      for (const b of data.behaviors ?? []) {
        const initName = data.init?.[b];
        const fn = initName ? loaded[b]?.[initName] : undefined;
        if (typeof fn === 'function') (fn as () => void)();
      }
      // 额外接线脚本（charts 渲染数据、context-menu 注册、演示回显等），
      // 以 camelCase + 'Mod' 形参暴露各模块（context-menu → contextMenuMod）。
      if (data.script) {
        const keys = Object.keys(loaded);
        const names = keys.map(
          (b) => b.replace(/-([a-z])/g, (_m, c: string) => c.toUpperCase()) + 'Mod',
        );
        try {
          const fn = new Function(...names, data.script) as (...args: unknown[]) => void;
          fn(...keys.map((k) => loaded[k]));
        } catch (err) {
          console.error('[docs] 演示接线脚本执行失败', err);
          throw err;
        }
      }
    }
    void boot();
  </script>
</Docs>

<style is:global>
  .doc-note { font-size: 13px; color: var(--token-text-muted); margin: 14px 0 10px; }
  .doc-note--warn {
    padding: 10px 14px;
    border-left: 2px solid var(--token-warning);
    background: color-mix(in srgb, var(--token-warning) 6%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    line-height: 1.7;
  }

  .doc-pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--token-line-soft);
  }
  .doc-pager-link { display: flex; flex-direction: column; gap: 2px; }
  .doc-pager-link:hover { text-decoration: none; }
  .doc-pager-link:hover .doc-pager-name { color: var(--token-accent-deep, var(--token-accent)); }
  .doc-pager-next { margin-left: auto; text-align: right; }
  .doc-pager-label { font-size: 11px; color: var(--token-text-faint); letter-spacing: 1px; }
  .doc-pager-name { font-size: 14px; color: var(--token-accent); font-weight: 500; }
</style>
