---
import Docs from '../../layouts/Docs.astro';
import { COMPONENTS, GROUPS, tierOf } from '../../lib/components';
---
<Docs title="组件 · ICEN UI" description={`ICEN UI 组件总览：${GROUPS.join(' / ')}共 ${GROUPS.length} 个分组，每个组件一页文档。`}>
  <h1 class="page-title">组件</h1>
  <p class="page-desc">
    {COMPONENTS.length} 个无框架组件，{GROUPS.length} 个分组。全部消费同一套设计令牌——切换右上角的预设、明暗与风格，每张卡片即刻换装。
    卡角 <span class="comp-tier comp-tier--core">Core</span> = 1.0 冻结轨道；<span class="comp-tier comp-tier--beta">Beta</span> = 图表 / AI / 知识库演进层，随 minor 快速迭代。
  </p>

  {GROUPS.map((g) => {
    const items = COMPONENTS.filter((c) => c.group === g);
    return (
      <section class="cg">
        <header class="cg-head">
          <h2 class="cg-name">{g}</h2>
          <span class="cg-count icen-mono">{items.length}</span>
        </header>
        <div class="comp-grid">
          {items.map((c) => {
            const tier = tierOf(c.slug, c.group);
            return (
              <a class="comp-card" href={`/components/${c.slug}/`}>
                <span class:list={['comp-tier', `comp-tier--${tier}`]} title={tier === 'beta' ? '演进层：随 minor 快速迭代，0.x 期间不保兼容' : '稳定层：1.0 冻结轨道，破坏性变更须公告'}>{tier === 'beta' ? 'Beta' : 'Core'}</span>
                <span class="comp-card-name">{c.name}</span>
                <span class="comp-card-slug icen-mono">{c.slug}</span>
                <span class="comp-card-desc">{c.desc}</span>
              </a>
            );
          })}
        </div>
      </section>
    );
  })}
</Docs>

<style is:global>
  .page-title { font-family: var(--icen-font-heading); font-size: 26px; font-weight: 700; letter-spacing: -.02em; margin: 0 0 8px; }
  .page-desc { color: var(--icen-token-text-muted); font-size: 13px; line-height: 1.65; margin: 0 0 32px; max-width: 680px; }

  /* ── 分组：安静脚手架，卡片当主角 ── */
  .cg { margin-bottom: 34px; }
  .cg-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 2px 10px;
  }
  .cg-name { font-size: 13px; font-weight: 600; letter-spacing: 0; color: var(--icen-token-text); margin: 0; }
  .cg-count { font-size: 10px; font-variant-numeric: tabular-nums; color: var(--icen-token-text-muted); padding: 1px 5px; border: 1px solid var(--icen-token-separator-soft); border-radius: var(--icen-radius-full); }

  /* ── 产品卡：hairline 表面，hover 只加边界与底色 ── */
  .comp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .comp-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 13px 14px 12px;
    border: 1px solid var(--icen-token-separator-soft);
    border-radius: var(--icen-control-radius-lg);
    background: var(--icen-token-surface);
    text-decoration: none;
    content-visibility: auto;
    contain-intrinsic-size: auto 104px;
    transition:
      background-color var(--icen-duration-fast) var(--icen-ease-out),
      border-color var(--icen-duration-fast) var(--icen-ease-out);
  }
  .comp-card:hover {
    border-color: var(--icen-token-control-border-hover);
    background: var(--icen-token-surface-chrome);
    text-decoration: none;
  }
  .comp-card:active { background: var(--icen-token-surface-pressed); }
  .comp-card:focus-visible {
    outline: none;
    border-color: var(--icen-token-accent);
    box-shadow: var(--icen-ring);
  }

  /* 组件名：界面字号与字重，保持产品语言 */
  .comp-card-name {
    font-family: var(--icen-font-heading);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -.01em;
    color: var(--icen-token-text);
  }
  /* 稳定性分层角标（tierOf 同 docs/contracts/tiers.json；与详情页徽标同色系） */
  .comp-tier {
    position: absolute;
    top: 9px;
    inset-inline-end: 9px;
    display: inline-flex;
    align-items: center;
    height: 17px;
    padding: 0 6px;
    border-radius: var(--icen-radius-full);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .02em;
    cursor: help;
    border: 1px solid color-mix(in srgb, var(--icen-token-success) 35%, transparent);
    color: var(--icen-token-success);
    background: color-mix(in srgb, var(--icen-token-success) 8%, transparent);
  }
  .comp-tier--beta {
    border-color: color-mix(in srgb, var(--icen-token-warning) 35%, transparent);
    color: var(--icen-token-warning);
    background: color-mix(in srgb, var(--icen-token-warning) 8%, transparent);
  }
  .comp-card-slug { font-size: 10.5px; color: var(--icen-token-text-muted); padding-inline-end: 44px; }
  .comp-card-desc {
    font-size: 12px;
    color: var(--icen-token-text-muted);
    line-height: 1.55;
    margin-top: 3px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .comp-card { transition: none; }
  }
</style>
