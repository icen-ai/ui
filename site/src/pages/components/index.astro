---
import Docs from '../../layouts/Docs.astro';
import { COMPONENTS, GROUPS, tierOf } from '../../lib/components';
---
<Docs title="组件 · ICEN UI" description={`ICEN UI 组件总览：${GROUPS.join(' / ')}共 ${GROUPS.length} 个分组，每个组件一页文档。`}>
  <h1 class="page-title">组件</h1>
  <p class="page-desc">
    {COMPONENTS.length} 个无框架组件，{GROUPS.length} 个分组。全部消费同一套设计令牌——切换右上角的预设、明暗与风格，每张卡片即刻换装。
    卡角 <span class="comp-tier comp-tier--core">Core</span> = 1.0 冻结轨道；<span class="comp-tier comp-tier--beta">Beta</span> = 图表 / AI / 知识库演进层，随 minor 快速迭代。
  </p>

  {GROUPS.map((g) => {
    const items = COMPONENTS.filter((c) => c.group === g);
    return (
      <section class="cg">
        <header class="cg-head">
          <h2 class="cg-name">{g}</h2>
          <span class="cg-count icen-mono">{items.length}</span>
        </header>
        <div class="comp-grid">
          {items.map((c) => {
            const tier = tierOf(c.slug, c.group);
            return (
              <a class="comp-card" href={`/components/${c.slug}/`}>
                <span class:list={['comp-tier', `comp-tier--${tier}`]} title={tier === 'beta' ? '演进层：随 minor 快速迭代，0.x 期间不保兼容' : '稳定层：1.0 冻结轨道，破坏性变更须公告'}>{tier === 'beta' ? 'Beta' : 'Core'}</span>
                <span class="comp-card-name">{c.name}</span>
                <span class="comp-card-slug icen-mono">{c.slug}</span>
                <span class="comp-card-desc">{c.desc}</span>
              </a>
            );
          })}
        </div>
      </section>
    );
  })}
</Docs>

<style is:global>
  .page-title { font-family: var(--icen-font-heading); font-size: 30px; font-weight: 700; letter-spacing: 1px; margin: 0 0 10px; }
  .page-desc { color: var(--icen-token-text-muted); font-size: 14px; line-height: 1.7; margin: 0 0 40px; max-width: 640px; }

  /* ── 分组：安静脚手架，卡片当主角 ── */
  .cg { margin-bottom: 44px; }
  .cg-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 2px 14px;
  }
  .cg-name { font-size: 16px; font-weight: 600; letter-spacing: 0.5px; color: var(--icen-token-text); margin: 0; }
  .cg-count { font-size: 12px; font-variant-numeric: tabular-nums; color: var(--icen-token-text-faint); }

  /* ── 产品卡：常驻柔和表面 + 发丝边 + 微环境光，静止即有存在感 ── */
  .comp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(236px, 1fr));
    gap: 14px;
  }
  .comp-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 18px 20px 16px;
    border: 1px solid var(--icen-token-line-soft);
    border-radius: var(--icen-radius-xl);
    background: linear-gradient(
      180deg,
      var(--icen-token-surface),
      color-mix(in srgb, var(--icen-token-bg-soft) 55%, var(--icen-token-surface))
    );
    box-shadow: var(--icen-token-shadow-ambient, 0 1px 2px color-mix(in srgb, var(--icen-token-text) 4%, transparent));
    text-decoration: none;
    content-visibility: auto;             /* 117 张卡的长页：视口外跳过渲染 */
    contain-intrinsic-size: auto 118px;
    transition:
      transform var(--icen-duration-fast) var(--icen-ease-out),
      box-shadow var(--icen-duration-fast) var(--icen-ease-out),
      border-color var(--icen-duration-fast) var(--icen-ease-out);
  }
  .comp-card:hover {
    transform: translateY(-2px);
    border-color: var(--icen-token-line);
    box-shadow: var(--icen-token-shadow-card);
    text-decoration: none;
  }
  .comp-card:active { transform: translateY(0); }
  .comp-card:focus-visible {
    outline: none;
    border-color: var(--icen-token-line);
    box-shadow: var(--icen-ring-soft);
  }

  /* 组件名：展示宋体（原单字徽章的字型移到完整标题上） */
  .comp-card-name {
    font-family: var(--icen-font-heading);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--icen-token-text);
  }
  /* 稳定性分层角标（tierOf 同 docs/contracts/tiers.json；与详情页徽标同色系） */
  .comp-tier {
    position: absolute;
    top: 10px;
    inset-inline-end: 10px;
    display: inline-flex;
    align-items: center;
    height: 18px;
    padding: 0 7px;
    border-radius: var(--icen-radius-full);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: help;
    border: 1px solid color-mix(in srgb, var(--icen-token-success) 40%, transparent);
    color: var(--icen-token-success);
    background: color-mix(in srgb, var(--icen-token-success) 7%, transparent);
  }
  .comp-tier--beta {
    border-color: color-mix(in srgb, var(--icen-token-warning) 40%, transparent);
    color: var(--icen-token-warning);
    background: color-mix(in srgb, var(--icen-token-warning) 7%, transparent);
  }
  .comp-card-slug { font-size: 11px; color: var(--icen-token-text-faint); padding-inline-end: 44px; }
  .comp-card-desc {
    font-size: 12px;
    color: var(--icen-token-text-muted);
    line-height: 1.65;
    margin-top: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .comp-card { transition: none; }
  }
</style>
