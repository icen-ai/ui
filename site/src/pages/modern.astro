---
import themes from '../../../src/tokens/themes.json';
import { iconHTML } from '../../../src/behaviors/icons';
import '../../../src/tokens/colors.css';
import '../../../src/tokens/style-profiles.css';
import '../../../src/tokens/scrollbars.css';
import '../../../src/tokens/typography.css';
import '../../../src/base.css';
import '../../../src/tokens/design.css';
import '../../../src/tokens/chinese.css';
import '../../../src/tokens/soviet.css';
import '../../../src/tokens/pixel.css';
import '../../../src/components/btn.css';
import '../../../src/components/input.css';
import '../../../src/components/select.css';
import '../../../src/components/segmented.css';
import '../../../src/components/switch.css';
import '../../../src/components/menu.css';
import '../../../src/components/modal.css';
import '../../../src/components/pill.css';
import '../../../src/components/table.css';
import '../../../src/components/material.css';
import '../../../src/components/material-chinese.css';
import '../../../src/components/material-soviet.css';
---
<!doctype html>
<html lang="zh-CN" data-icen-preset="modern">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="现代 · ICEN UI 原语体系。瓷白内容面、轻盈操作层，以及可以成为你品牌的设计规则。" />
    <title>现代 · ICEN UI 原语工作室</title>
  </head>
  <body>
    <a class="icen-skip-link" href="#studio-content">跳到内容</a>
    <header class="studio-header" data-icen-material="chrome">
      <a href="/primitives/" class="studio-wordmark">icen<span> / 原语工作室</span></a>
      <div class="studio-header-actions"><span class="studio-muted">原语 <span class="icen-select studio-header-select" data-icen-select data-icen-value="modern"><button class="icen-select-trigger icen-pressable icen-focus-ring icen-select-trigger--sm" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="原语"><span class="icen-select-value">现代</span></button><div class="icen-select-panel" hidden><button class="icen-select-option" type="button" data-icen-value="modern">现代</button><button class="icen-select-option" type="button" data-icen-value="chinese">中式</button><button class="icen-select-option" type="button" data-icen-value="soviet">苏式</button><button class="icen-select-option" type="button" data-icen-value="pixel">像素</button></div><input type="hidden" data-icen-select-value value="modern" id="primitive-control" /></span></span><button class="icen-btn icen-btn-ghost" id="theme-toggle" aria-pressed="false">深色模式</button></div>
    </header>
    <main id="studio-content" class="studio-layout">
      <aside class="studio-inspector" aria-label="设计原语设置">
        <p class="studio-eyebrow">ICEN DESIGN PRIMITIVES</p>
        <h1><span id="primitive-title">现代</span><span class="studio-period">。</span></h1>
        <p class="studio-intro" id="primitive-intro">让内容清楚，<br />让操作轻盈。</p>
        <p class="studio-description" id="primitive-description">细微的光，清楚的字，恰到好处的距离。每一次操作，都有稳稳的回应。</p>
        <div class="studio-controls">
          <span class="studio-control-label">色彩主题</span>
          <span class="icen-select" data-icen-select data-icen-value="modern"><button class="icen-select-trigger icen-pressable icen-focus-ring" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="色彩主题"><span class="icen-select-value">现代</span></button><div class="icen-select-panel" hidden>{themes.map((theme) => <button class="icen-select-option" type="button" data-icen-value={theme.id}>{theme.name}</button>)}</div><input type="hidden" data-icen-select-value value="modern" id="palette-control" /></span>
          <label>品牌强调色<input id="accent-control" type="color" value="#0062cc" /><span id="accent-value">#0062cc</span></label>
          <label for="radius-control">控件圆角 <output id="radius-value">10 px</output></label>
          <input id="radius-control" type="range" min="0" max="20" value="10" />
          <label for="glass-control">操作层透光 <output id="glass-value">16%</output></label>
          <input id="glass-control" type="range" min="0" max="30" value="16" />
          <label for="density-control">布局密度</label>
          <span class="icen-select" data-icen-select data-icen-value="normal"><button class="icen-select-trigger icen-pressable icen-focus-ring" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="布局密度"><span class="icen-select-value">标准 · 从容清晰</span></button><div class="icen-select-panel" hidden><button class="icen-select-option" type="button" data-icen-value="normal">标准 · 从容清晰</button><button class="icen-select-option" type="button" data-icen-value="compact">紧凑 · 更多信息</button><button class="icen-select-option" type="button" data-icen-value="comfortable">宽松 · 更多留白</button></div><input type="hidden" data-icen-select-value value="normal" id="density-control" /></span>
          <label class="studio-checkbox"><input id="opaque-control" type="checkbox" />减少透明效果</label>
          <button class="icen-btn" id="reset-design">恢复现代</button>
        </div>
        <p class="studio-note">调节会同时作用于页面、菜单与弹窗。<br />小字号保持清晰，密度只改变节奏。</p>
        <a class="studio-doc-link" href="#authoring">创建自己的原语方案 ↗</a>
      </aside>
      <div class="studio-stage">
        <div class="studio-stage-heading"><div><p class="studio-eyebrow">在真实界面中感受</p><h2 id="primitive-headline">安静，也有分寸。</h2></div><span class="studio-version" id="primitive-version">现代 / 实时预览</span></div>
        <div class="studio-materials" aria-label="三种材料">
          <div data-icen-material="content"><span class="studio-sample-symbol" aria-hidden="true">阅</span><strong>内容</strong><span>稳定的底色，安放文字</span></div>
          <div class="studio-material-backdrop"><div data-icen-material="chrome"><span class="studio-sample-symbol" aria-hidden="true">序</span><strong>操作</strong><span>有序的层次，清楚的动作</span></div></div>
          <div class="studio-material-backdrop studio-material-offset"><div data-icen-material="floating"><span class="studio-sample-symbol" aria-hidden="true">浮</span><strong>浮层</strong><span>一层距离，聚焦此刻</span></div></div>
        </div>
        <section class="studio-workbench" data-icen-material="content" aria-label="组件场景">
          <div class="studio-workbench-nav"><div class="icen-segmented" role="tablist" aria-label="示例场景">
            <button class="icen-segmented-item is-active" id="tab-settings" role="tab" aria-selected="true" aria-controls="scene-settings" data-scene="settings">账户设置</button>
            <button class="icen-segmented-item" id="tab-workspace" role="tab" aria-selected="false" aria-controls="scene-workspace" tabindex="-1" data-scene="workspace">知识工作台</button>
            <button class="icen-segmented-item" id="tab-chat" role="tab" aria-selected="false" aria-controls="scene-chat" tabindex="-1" data-scene="chat">AI 对话</button>
          </div><button class="icen-btn icen-btn-ghost" id="menu-trigger" aria-haspopup="menu" aria-expanded="false"><span>更多操作</span><Fragment set:html={iconHTML('more')} /></button></div>
          <div id="scene-settings" role="tabpanel" aria-labelledby="tab-settings" class="studio-scene">
            <div class="studio-section-title"><div><h3>个人资料</h3><p>你的名字，会出现在协作与分享中。</p></div><div class="studio-avatar" aria-hidden="true">林</div></div>
            <form id="profile-form">
              <div class="studio-form-grid"><label>显示名称<span class="icen-input-wrap"><input class="icen-input" name="displayName" value="林知白" required /></span></label><label>电子邮箱<span class="icen-input-wrap"><input class="icen-input" type="email" name="email" value="zhibai@example.com" required /></span></label></div>
              <div class="studio-setting-row"><div><strong>产品动态</strong><p>只在有值得告诉你的变化时发送邮件。</p></div><button type="button" class="icen-switch" role="switch" aria-checked="true" aria-label="接收产品动态"><span class="icen-switch-thumb"></span></button></div>
              <div class="studio-form-actions"><p id="save-status" role="status">资料仅用于此预览。</p><button class="icen-btn icen-btn-primary" type="submit">保存更改</button></div>
            </form>
          </div>
          <div id="scene-workspace" role="tabpanel" aria-labelledby="tab-workspace" class="studio-scene" hidden>
            <div class="studio-section-title"><div><h3>团队知识库</h3><p>最近更新的资料，随时可以接着读。</p></div><button class="icen-btn" data-icen-modal-open="new-note">新建笔记</button></div>
            <div class="studio-search icen-input-wrap"><input class="icen-input" id="knowledge-search" type="search" placeholder="搜索资料" aria-label="搜索资料" /></div>
            <table class="icen-table studio-table"><thead><tr><th>资料</th><th>更新日期</th><th>状态</th></tr></thead><tbody>
              <tr><td>产品设计原则<span>设计规范 · 12 页</span></td><td>10 月 16 日</td><td><span class="icen-pill icen-pill--success">已同步</span></td></tr>
              <tr><td>品牌语言与写作<span>内容指南 · 8 页</span></td><td>10 月 15 日</td><td><span class="icen-pill icen-pill--success">已同步</span></td></tr>
              <tr><td>秋季产品访谈<span>用户研究 · 24 页</span></td><td>10 月 12 日</td><td><span class="icen-pill">草稿</span></td></tr>
            </tbody></table><p id="search-status" class="studio-muted" role="status"></p>
          </div>
          <div id="scene-chat" role="tabpanel" aria-labelledby="tab-chat" class="studio-scene" hidden>
            <div class="studio-section-title"><div><h3>一起，把想法变清楚。</h3><p>稳定的阅读，轻巧的工具反馈。</p></div><span class="studio-muted">新的对话</span></div>
            <div class="studio-conversation" aria-live="polite"><p class="studio-message-user">好的界面，应该带来什么感受？</p><div><span class="studio-assistant-label">icen</span><p>你知道自己在哪里，也知道下一步可以做什么。<br />文字清楚，操作及时，界面给思考留下空间。</p><details><summary>已参考设计原则 · 2 条</summary><p>内容保持稳定；反馈紧随操作。</p></details></div></div>
            <form id="chat-form" class="studio-composer"><label for="chat-input" class="icen-sr-only">继续对话</label><input id="chat-input" placeholder="从一个想法开始…" required /><button class="icen-btn icen-btn-primary" type="submit">发送</button></form>
          </div>
        </section>
        <section class="studio-principles"><div><span>光</span><h3>看得见的距离</h3><p>近处的影清楚，远处的影柔和。深色里，边缘依然可辨。</p></div><div><span>形</span><h3>触手可及的分寸</h3><p>轮廓彼此呼应。鼠标、键盘和指尖，都有自己的从容。</p></div><div><span>字</span><h3>读起来更轻松</h3><p>标题有轻重，正文有呼吸。复杂的信息，也能一眼找到重点。</p></div></section>
        <section id="authoring" class="studio-authoring" data-icen-material="content"><div><p class="studio-eyebrow">属于你的设计</p><h2>一个名字，一组原语。</h2><p>以现代为起点，修改品牌色、几何与材质。共享配方会照顾现有组件。</p></div><pre><code id="design-export">&lt;html data-icen-preset="modern"&gt;

/* 自己的 CSS，无需复制组件 */
:root[data-icen-preset="my-brand"] &#123;
  --icen-design-accent: #0062cc;
  --icen-design-radius: 10px;
&#125;</code></pre><button class="icen-btn" id="copy-design">复制当前配方</button><p id="copy-status" role="status"></p></section>
        <footer class="studio-footer"><span>icen / 现代</span><span>精确，在每一处不经意。</span><a href="/primitives/">查看原语文档 ↗</a></footer>
      </div>
    </main>
    <div class="icen-menu" id="studio-menu" role="menu" aria-label="更多操作" hidden><button class="icen-menu-item" role="menuitem" data-icen-modal-open="new-note">新建笔记</button><button class="icen-menu-item" role="menuitem" id="export-recipe">查看当前配方</button></div>
    <div class="icen-modal-backdrop" data-icen-modal="new-note" hidden><section class="icen-modal" role="dialog" aria-modal="true" aria-labelledby="note-title"><div class="icen-modal-header"><h2 id="note-title" class="icen-modal-title">留下一点想法</h2><button class="icen-btn icen-btn-ghost" data-icen-modal-close aria-label="关闭"><Fragment set:html={iconHTML('close')} /></button></div><div class="icen-modal-body"><p>一个安静的空间，收好此刻的灵感。</p><label>笔记标题<span class="icen-input-wrap"><input class="icen-input" id="note-input" placeholder="例如：界面里的留白" /></span></label></div><div class="icen-modal-footer"><button class="icen-btn" data-icen-modal-close>取消</button><button class="icen-btn icen-btn-primary" id="save-note">保存笔记</button></div></section></div>
    <script>
      import themes from '../../../src/tokens/themes.json';
      import { initModal, closeModal } from '../../../src/behaviors/modal';
      import { initSwitch } from '../../../src/behaviors/controls';
      import { initSelect, refreshSelect } from '../../../src/behaviors/select';
      import { createDesign, mountDesign, setDesign, prepareDesignChange } from '../../../src/behaviors/design';
      import { openPopover, closePopover } from '../../../src/behaviors/popover';
      import { initSiteI18n } from '../lib/site-i18n';
      initModal();
      initSwitch();
      initSelect();
      initSiteI18n(); /* 独立页同样接全站 i18n：词表换装 + JS 重渲染自动补翻 */
      const root = document.documentElement;
      const setStudioSelect = (id: string, value: string): void => {
        const input = document.getElementById(id) as HTMLInputElement | null;
        if (!input) return;
        input.value = value;
        input.closest('.icen-select')?.setAttribute('data-icen-value', value);
        refreshSelect();
      };
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const primitiveCopy: Record<string, {name:string;intro:string;description:string;headline:string}> = {
        modern: {name:'现代',intro:'让内容清楚，\n让操作轻盈。',description:'细微的光，清楚的字，恰到好处的距离。每一次操作，都有稳稳的回应。',headline:'安静，也有分寸。'},
        chinese: {name:'中式',intro:'留白有意，\n落笔有度。',description:'书页的呼吸，器物的温润，印记的分寸。让东方的从容，成为日常的使用感受。',headline:'疏密之间，自见风骨。'},
        soviet: {name:'苏式',intro:'以结构，\n承托每一次行动。',description:'坚实的体块，明确的轴线，果断的字形。把纪念性建筑的力量，收进清楚好用的界面。',headline:'秩序，拥有自己的力量。'},
        pixel: {name:'像素',intro:'每一格，\n都有自己的位置。',description:'整齐的网格、清晰的点阵与利落的按压。用最少的像素，表达完整的秩序。',headline:'小小方寸，自有秩序。'},
      };
      let customAccent = '';
      let removeBrand = () => {};
      const themeButton = $<HTMLButtonElement>('theme-toggle');
      themeButton.addEventListener('click', () => {
        prepareDesignChange();
        const dark = root.getAttribute('data-icen-theme') !== 'dark';
        root.toggleAttribute('data-icen-theme', dark);
        if (dark) root.setAttribute('data-icen-theme','dark');
        themeButton.setAttribute('aria-pressed', String(dark));
        themeButton.textContent = dark ? '浅色模式' : '深色模式';
        syncControls();
        updateExport();
      });
      const radius = $<HTMLInputElement>('radius-control');
      const glass = $<HTMLInputElement>('glass-control');
      const accent = $<HTMLInputElement>('accent-control');
      function syncControls() {
        const computed = getComputedStyle(root);
        radius.value = String(parseFloat(computed.getPropertyValue('--icen-design-radius')) || 0);
        glass.value = String(Math.round(100 - parseFloat(computed.getPropertyValue('--icen-design-glass-opacity'))));
        $('radius-value').textContent = `${radius.value} px`;
        $('glass-value').textContent = `${glass.value}%`;
        const theme = themes.find((item)=>item.id===root.getAttribute('data-icen-preset'));
        const palette = root.getAttribute('data-icen-theme')==='dark' ? theme?.dark : theme?.light;
        if (palette && !customAccent) { accent.value=palette.accentStrong; $('accent-value').textContent=palette.accentStrong; }
      }
      function syncPrimitive() {
        const profile = primitiveCopy[root.getAttribute('data-icen-style') || 'modern'] || primitiveCopy.modern;
        $('primitive-title').textContent = profile.name;
        $('primitive-intro').textContent = profile.intro;
        $('primitive-description').textContent = profile.description;
        $('primitive-headline').textContent = profile.headline;
        $('primitive-version').textContent = `${profile.name} / 实时预览`;
        syncControls(); updateExport();
      }
      $('primitive-control').addEventListener('change',(event)=>{prepareDesignChange();root.setAttribute('data-icen-style',(event.target as HTMLInputElement).value);syncPrimitive();});
      $('palette-control').addEventListener('change',(event)=>{removeBrand();customAccent='';setDesign((event.target as HTMLInputElement).value);syncControls();updateExport();});
      function updateExport() {
        const density=root.getAttribute('data-icen-density');
        const opaque=root.getAttribute('data-icen-transparency');
        const overrides = ['--icen-design-radius','--icen-design-glass-opacity'].filter((property)=>root.style.getPropertyValue(property)).map((property)=>`  ${property}: ${root.style.getPropertyValue(property)};`).join('\n');
        $('design-export').textContent = `<html data-icen-preset="${root.getAttribute('data-icen-preset') || 'modern'}" data-icen-style="${root.getAttribute('data-icen-style') || 'modern'}"${root.hasAttribute('data-icen-theme') ? ' data-icen-theme="dark"' : ''}${density ? ` data-icen-density="${density}"` : ''}${opaque ? ' data-icen-transparency="reduced"' : ''}>\n\n/* Import @icen.ai/ui/tokens.css first. */${customAccent ? `\n${$('brand-style')?.textContent || ''}` : ''}${overrides ? `\n:root[data-icen-preset] {\n${overrides}\n}` : ''}`;
      }
      radius.addEventListener('input', () => { root.style.setProperty('--icen-design-radius', `${radius.value}px`); $('radius-value').textContent = `${radius.value} px`; updateExport(); });
      glass.addEventListener('input', () => { root.style.setProperty('--icen-design-glass-opacity', `${100 - Number(glass.value)}%`); $('glass-value').textContent = `${glass.value}%`; updateExport(); });
      accent.addEventListener('input', () => {
        const value = accent.value;
        // A picker accepts every color. Use the chosen hue with a readable ink
        // tone for light mode and a light tone for dark; compiler verifies pairs.
        const rgb = [1,3,5].map((i) => parseInt(value.slice(i,i+2),16));
        const mix = (amount: number, target: number) => '#' + rgb.map((v) => Math.round(v*(1-amount)+target*amount).toString(16).padStart(2,'0')).join('');
        let compiled;
        for (let step = 0; step <= 10; step++) {
          try {
            compiled = createDesign({ name:'my-brand', light:{canvas:'#f5f6f8',surface:'#ffffff',ink:'#202124',muted:'#616671',accent:mix(step/10,0),onAccent:'#ffffff'},dark:{canvas:'#15171b',surface:'#25282e',ink:'#f2f4f7',muted:'#aeb5c2',accent:mix(Math.max(.5,step/10),255),onAccent:'#10223c'} }); break;
          } catch { /* Increase contrast, preserving the chosen hue family. */ }
        }
        if (!compiled) return;
        removeBrand(); removeBrand = mountDesign(compiled); setDesign(compiled.name);
        customAccent = value; $('accent-value').textContent = value;
        const style = document.head.lastElementChild; if (style) style.id = 'brand-style';
        updateExport();
      });
      $('density-control').addEventListener('change', (event) => {root.setAttribute('data-icen-density',(event.target as HTMLInputElement).value);updateExport();});
      $('opaque-control').addEventListener('change', (event) => { if ((event.target as HTMLInputElement).checked) root.setAttribute('data-icen-transparency','reduced'); else root.removeAttribute('data-icen-transparency'); updateExport(); });
      $('reset-design').addEventListener('click', () => { removeBrand(); customAccent=''; setDesign('modern'); root.removeAttribute('style'); root.setAttribute('data-icen-style','modern'); root.removeAttribute('data-icen-density'); root.removeAttribute('data-icen-transparency'); setStudioSelect('primitive-control','modern'); setStudioSelect('palette-control','modern'); setStudioSelect('density-control','normal'); $<HTMLInputElement>('opaque-control').checked=false; syncPrimitive(); });
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-scene]'));
      function selectTab(tab: HTMLButtonElement) { tabs.forEach((button) => { const active=button===tab; button.setAttribute('aria-selected',String(active)); button.classList.toggle('is-active',active); button.tabIndex=active ? 0 : -1; $(`scene-${button.dataset.scene}`).hidden=!active; }); }
      tabs.forEach((tab,index) => { tab.addEventListener('click',()=>selectTab(tab)); tab.addEventListener('keydown',(event)=> { const direction=root.dir==='rtl' ? -1 : 1; let next=index; if(event.key==='ArrowRight') next=(index+direction+tabs.length)%tabs.length; else if(event.key==='ArrowLeft') next=(index-direction+tabs.length)%tabs.length; else if(event.key==='Home') next=0; else if(event.key==='End') next=tabs.length-1; else return; event.preventDefault(); selectTab(tabs[next]); tabs[next].focus(); }); });
      $('profile-form').addEventListener('submit',(event)=>{ event.preventDefault(); $('save-status').textContent='已保存到本次预览。'; });
      $('knowledge-search').addEventListener('input',(event)=>{ const query=(event.target as HTMLInputElement).value.trim(); let count=0; document.querySelectorAll<HTMLTableRowElement>('.studio-table tbody tr').forEach((row)=>{row.hidden=!(row.textContent||'').includes(query); if(!row.hidden)count++;}); $('search-status').textContent=`${count} 份资料`; });
      const menuTrigger = $<HTMLButtonElement>('menu-trigger');
      const menu = $('studio-menu');
      menuTrigger.addEventListener('click',()=> { if (!menu.hidden) { closePopover(menu); return; } openPopover(menu,{anchor:menuTrigger,side:'bottom',align:'end',onClose:()=>{ menuTrigger.setAttribute('aria-expanded','false'); if(menu.contains(document.activeElement))menuTrigger.focus(); }}); menuTrigger.setAttribute('aria-expanded','true'); menu.querySelector<HTMLButtonElement>('button')?.focus(); });
      menu.addEventListener('click',()=>closePopover(menu));
      menu.addEventListener('keydown',(event)=>{const items=Array.from(menu.querySelectorAll<HTMLButtonElement>('button'));const index=items.indexOf(document.activeElement as HTMLButtonElement);if(event.key==='ArrowDown'||event.key==='ArrowUp'){event.preventDefault();items[(index+(event.key==='ArrowDown'?1:-1)+items.length)%items.length].focus();}if(event.key==='Escape'){event.preventDefault();event.stopPropagation();closePopover(menu);menuTrigger.focus();}if(event.key==='Tab')closePopover(menu);});
      $('export-recipe').addEventListener('click',()=>{updateExport(); $('authoring').scrollIntoView({behavior:'smooth'});});
      $('save-note').addEventListener('click',()=>{const title=$<HTMLInputElement>('note-input').value.trim(); if(!title){$<HTMLInputElement>('note-input').focus();return;} const row=document.createElement('tr'); [title,'刚刚','草稿'].forEach((text)=>{const cell=document.createElement('td');cell.textContent=text;row.append(cell);}); document.querySelector('.studio-table tbody')?.prepend(row);closeModal('new-note'); selectTab(tabs[1]);});
      $('chat-form').addEventListener('submit',(event)=>{event.preventDefault();const input=$<HTMLInputElement>('chat-input');if(!input.value.trim())return;const message=document.createElement('p');message.className='studio-message-user';message.textContent=input.value;document.querySelector('.studio-conversation')?.append(message);const reply=document.createElement('p');reply.textContent='已记下这个想法。这是本地交互预览，尚未接入 AI 服务。';document.querySelector('.studio-conversation')?.append(reply);input.value='';});
      $('copy-design').addEventListener('click',async()=>{updateExport();try{await navigator.clipboard.writeText($('design-export').textContent||'');$('copy-status').textContent='已复制当前配方。';}catch{$('copy-status').textContent='请选中上方配方手动复制。';}});
      syncPrimitive();
    </script>
