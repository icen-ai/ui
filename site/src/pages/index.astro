---
import { themeSwitcherHTML } from '../../../src/behaviors/theme-switcher';
import { iconHTML } from '../../../src/behaviors/icons';
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import PmInstall from '../components/PmInstall.astro';
import { COMPONENTS, GROUPS } from '../lib/components';
import pkg from '../../../package.json';

import '../../../src/components/input.css';
import '../../../src/components/switch.css';
import '../../../src/components/kb.css';
import '../../../src/components/kb-search.css';
import '../../../src/components/feedback.css';
import '../../../src/components/media.css';
import '../../../src/components/content.css';
import '../../../src/components/slider.css';
import '../../../src/components/tag.css';
import '../../../src/components/charts.css';
import '../../../src/components/chart-heatmap.css';
import '../../../src/components/chart-gauge.css';
import '../../../src/components/chart-sparkline.css';
import '../../../src/components/chart-pie.css';
import '../../../src/components/ai-chat.css';
import '../../../src/components/ai-tool.css';
import '../../../src/components/ai-panel.css';

/* 分组导航带：每组链接到伞页面 / 代表组件页 */
const GROUP_LINK: Record<string, string> = {
  '基础': 'btn', 'AI 原生': 'ai-overview', '表单': 'form', '数据展示': 'card',
  '图表': 'charts', '浮层': 'modal', '反馈': 'alert', '导航': 'nav',
};

/* 预设色板：展示内容为各预设自身的基值（色值即数据，非 UI 样式） */

import { readdirSync } from 'node:fs';
import { SLUGS } from '../../../scripts/slugs.mjs';
/* 数字带全部构建期派生（src/behaviors 目录 + SLUGS 清单），发版永不漂移 */
const behaviorCount = readdirSync(new URL('../../../src/behaviors', import.meta.url)).filter((f) => f.endsWith('.ts')).length;
const chartKitCount = SLUGS.filter((s) => s.startsWith('chart-')).length;
const aiCount = SLUGS.filter((s) => s.startsWith('ai-')).length;

const importCss = `import '@icen.ai/ui/tokens.css';
import '@icen.ai/ui/ui.css';`;
const htmlPreset = `<html class=" " data-icen-theme="dark" data-icen-preset="piano"> … </html>`;

const copySvg = `${iconHTML('copy',{size:14,className:'icen-copy-icon-clipboard'})}`;
const checkSvg = `${iconHTML('check',{size:14,className:'icen-copy-icon-check'})}`;
const searchSvg = `${iconHTML('search',{size:13})}`;
const featureIcons = {
  ai: `${iconHTML('sparkle',{size:16})}`,
  chart: `${iconHTML('chart-line',{size:16})}`,
  layers: `${iconHTML('layers',{size:16})}`,
  box: `${iconHTML('box',{size:16})}`,
};
---

<Base title="ICEN UI · 为 AI 时代而生的设计系统">
  <!-- ═══ Hero（背景全宽出血） ═══ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-orb hero-orb--a"></span>
      <span class="hero-orb hero-orb--b"></span>
      <span class="hero-orb hero-orb--c"></span>
      <span class="hero-grid"></span>
    </div>
    <div class="hero-inner">
      <a class="hero-pill fade-up" href="/components/ai-overview/">
        <span class="hero-pill-dot" aria-hidden="true"></span>
        <span class="hero-pill-badge">v{pkg.version}</span>
        <span>AI 原生组件族 · 图表通用层已发布</span>
        <span class="hero-pill-arrow" aria-hidden="true">→</span>
      </a>
      <h1 class="hero-title">
        <span class="reveal-line"><span>设计系统，</span></span>
        <span class="reveal-line"><span>为 <em class="hero-grad">AI 时代</em> 而生</span></span>
      </h1>
      <p class="hero-sub fade-up fade-up--2">
        组件、图表和 AI 界面，共用一套设计令牌。
        换肤不用改代码，UI 也能直接交给模型调用。
      </p>
      <div class="hero-actions fade-up fade-up--3">
        <a class="icen-btn icen-btn-primary icen-btn-lg" href="#quickstart">开始使用</a>
        <a class="icen-btn icen-btn-lg" href="/components/">浏览 {COMPONENTS.length} 个组件</a>
        <span class="install-chip">
          <span class="install-prompt" aria-hidden="true">$</span>
          <code class="install-cmd">bun add @icen.ai/ui</code>
          <button class="icen-copy-btn icen-copy-btn--icon install-copy" type="button" data-icen-copy="bun add @icen.ai/ui" data-icen-copy-icon aria-label="复制安装命令">
            <Fragment set:html={copySvg + checkSvg} />
          </button>
        </span>
      </div>

      <!-- 数字带：一眼看清规模（滚动入场时计数） -->
      <div class="hero-stats fade-up fade-up--4" role="list">
        <div class="hero-stat" role="listitem"><b data-icen-count={SLUGS.length}>0</b><span>组件入口</span></div>
        <div class="hero-stat" role="listitem"><b data-icen-count={behaviorCount}>0</b><span>行为模块</span></div>
        <div class="hero-stat" role="listitem"><b data-icen-count={chartKitCount}>0</b><span>图表类型</span></div>
        <div class="hero-stat" role="listitem"><b data-icen-count={aiCount}>0</b><span>AI 原生</span></div>
        <div class="hero-stat" role="listitem"><b data-icen-count="0">0</b><span>运行时依赖</span></div>
      </div>
    </div>
  </section>

  <!-- ═══ 袖珍组件群岛：19 个真实组件迷你卡，手工排布成有机云状（视差 × 呼吸 × 抬升三层变换互不冲突） ═══ -->
  <section class="stage-sec" aria-label="精选组件">
    <div class="sec-head">
      <p class="sec-over"><span class="sec-over-dot" aria-hidden="true"></span>SHOWCASE · 精选组件</p>
      <h2 class="sec-title">先体验，再安装</h2>
      <p class="sec-desc">下面都是实时渲染，不妨试试——悬停卡片看名字。</p>
    </div>
    <div class="isle-canvas" id="isle-canvas">
      <span class="isle-orbit" aria-hidden="true"></span>
      <span class="isle-glow" aria-hidden="true"></span>
      <span class="isle-glow isle-glow--cold" aria-hidden="true"></span>

      <div class="isle" data-icen-label="统计 + 迷你趋势 · stat / chart-sparkline" style="left:21%;top:0%">
        <article class="isle-card" style="--w:208px;--lev-duration:7.2s;--lev-delay:.4s">
          <p class="isle-label">周活跃用户</p>
          <div class="isle-stat-row"><b class="isle-stat-num">8,642</b><span class="icen-pill icen-pill--success">+12.4%</span></div>
          <div id="mc-spark"></div>
        </article>
      </div>

      <div class="isle" data-icen-label="贡献日历 · chart-calendar" style="left:41%;top:0%">
        <article class="isle-card" style="--w:230px;--lev-duration:6.6s;--lev-delay:1.2s">
          <div id="mc-cal"></div>
        </article>
      </div>

      <div class="isle" data-icen-label="仪表盘 · chart-gauge 轮询" style="left:78%;top:2%">
        <article class="isle-card isle-card--center" style="--w:132px;--lev-duration:8s;--lev-delay:.2s">
          <div id="mc-gauge"></div>
          <span class="icen-pill icen-pill--success isle-live"><span class="isle-live-dot" aria-hidden="true"></span>LIVE</span>
        </article>
      </div>

      <div class="isle" data-icen-label="任务 + 用量环 · ai-todo / ai-usage" style="left:1%;top:26%">
        <article class="isle-card" style="--w:232px;--lev-duration:6.2s;--lev-delay:.9s">
          <div class="isle-split">
            <div id="mc-todo"></div>
            <div id="mc-ring"></div>
          </div>
        </article>
      </div>

      <div class="isle" data-icen-label="AI 会话 · ai-chat 流式" style="left:27%;top:25%">
        <article class="isle-card" style="--w:252px;--lev-duration:7.6s;--lev-delay:1.5s">
          <div class="mc-chat" id="mc-chat"></div>
        </article>
      </div>

      <div class="isle" data-icen-label="环形占比 · chart-pie" style="left:61%;top:24%">
        <article class="isle-card" style="--w:186px;--lev-duration:6.9s;--lev-delay:.6s">
          <div id="mc-donut"></div>
        </article>
      </div>

      <div class="isle" data-icen-label="搜索输入 · input" style="left:82%;top:30%">
        <article class="isle-card" style="--w:200px;--lev-duration:7.4s;--lev-delay:1.1s">
          <div class="icen-input-wrap icen-control icen-input-wrap--sm">
            <span class="icen-input-leading"><Fragment set:html={searchSvg} /></span>
            <input class="icen-input" type="search" placeholder="搜索组件…" aria-label="搜索组件" />
          </div>
        </article>
      </div>

      <div class="isle" data-icen-label="知识库检索 · kb-retrieval" style="left:9%;top:57%">
        <article class="isle-card" style="--w:278px;--lev-duration:6.4s;--lev-delay:.3s">
          <div class="icen-kb-hits">
            <div class="icen-kb-hit">
              <div class="icen-kb-hit-rank icen-kb-num">1</div>
              <div class="icen-kb-hit-main">
                <div class="icen-kb-hit-title">三季度经营分析月报</div>
                <div class="icen-kb-hit-snippet">销售额 3.42 亿，环比下滑 6.8%…</div>
              </div>
              <div class="icen-kb-hit-side">
                <span class="icen-kb-score"><span class="icen-kb-score-bar"><i style="width:93%"></i></span><span class="icen-kb-score-value">0.930</span></span>
              </div>
            </div>
            <div class="icen-kb-hit">
              <div class="icen-kb-hit-rank icen-kb-num">2</div>
              <div class="icen-kb-hit-main">
                <div class="icen-kb-hit-title">供应链季度复盘</div>
                <div class="icen-kb-hit-snippet">交付周期从 14 天拉长到 21 天…</div>
              </div>
              <div class="icen-kb-hit-side">
                <span class="icen-kb-score"><span class="icen-kb-score-bar"><i style="width:86%"></i></span><span class="icen-kb-score-value">0.860</span></span>
              </div>
            </div>
          </div>
        </article>
      </div>

      <div class="isle" data-icen-label="徽章与标签 · pill / tag" style="left:46%;top:55%">
        <article class="isle-card" style="--w:178px;--lev-duration:5.8s;--lev-delay:1.4s">
          <div class="isle-wrap">
            <span class="icen-pill icen-pill--success">稳定</span>
            <span class="icen-pill icen-pill--warning">排队</span>
            <span class="icen-pill icen-pill--error">失败</span>
          </div>
          <div class="isle-wrap" style="margin-top:8px">
            <span class="icen-tag icen-tag--sm"><span class="icen-tag-label">设计系统</span></span>
            <span class="icen-tag icen-tag--sm icen-tag--accent"><span class="icen-tag-label">AI 原生</span></span>
          </div>
        </article>
      </div>

      <div class="isle" data-icen-label="开关 · switch" style="left:74%;top:57%">
        <article class="isle-card" style="--w:142px;--lev-duration:6.8s;--lev-delay:1s">
          <div class="isle-row"><button class="icen-switch icen-switch--sm" type="button" role="switch" aria-checked="true" aria-label="自动发布"><span class="icen-switch-thumb"></span></button><span class="isle-lb">自动</span></div>
          <div class="isle-row"><button class="icen-switch icen-switch--sm" type="button" role="switch" aria-checked="false" aria-label="预览"><span class="icen-switch-thumb"></span></button><span class="isle-lb">预览</span></div>
        </article>
      </div>

      <div class="isle" data-icen-label="AI 工具调用 · ai-tool-call" style="left:24%;top:79%">
        <article class="isle-card" style="--w:246px;--lev-duration:7s;--lev-delay:.8s">
          <div id="mc-tool"></div>
        </article>
      </div>

      <div class="isle" data-icen-label="滑块 · slider 可拖拽" style="left:57%;top:80%">
        <article class="isle-card" style="--w:200px;--lev-duration:6.3s;--lev-delay:1.25s">
          <div class="isle-row isle-row--spread"><span class="isle-lb">音量</span><span class="isle-dim" id="mc-slider-val">40</span></div>
          <div class="icen-slider">
            <div class="icen-slider-track"></div>
            <div class="icen-slider-fill" style="width:40%"></div>
            <div class="icen-slider-thumb" style="left:calc(40% - 8px)"></div>
            <input class="icen-slider-native" type="range" min="0" max="100" value="40" aria-label="音量" />
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ 预设换肤带：点击即换肤，全站零改动 ═══ -->
  <section class="presets-sec" aria-label="色彩预设">
    <div class="sec-head">
      <p class="sec-over"><span class="sec-over-dot" aria-hidden="true"></span>TOKENS · 色彩预设</p>
      <h2 class="sec-title">一套 tokens，六副面孔</h2>
      <p class="sec-desc">六套预设，明暗双模。点一张色卡，整站即刻换装。</p>
    </div>
    <Fragment set:html={themeSwitcherHTML({kind:"theme",layout:"inline",size:"lg"})} />
    <p class="preset-hint">{COMPONENTS.length} 个组件共享同一套设计令牌（<code>--icen-token-*</code>）——换肤不改一行组件代码。</p>
  </section>

  <!-- ═══ 特性 ═══ -->
  <section class="features-sec" aria-label="设计哲学">
    <div class="sec-head">
      <p class="sec-over"><span class="sec-over-dot" aria-hidden="true"></span>WHY · 设计哲学</p>
      <h2 class="sec-title">为下一个十年的界面而生</h2>
    </div>
    <div class="features">
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><Fragment set:html={featureIcons.ai} /></span>
        <h3 class="feature-title">AI 原生族</h3>
        <p class="feature-desc">做 AI 界面要用的零件都在：对话、推理、工具调用、审批。兼容主流模型协议，token 和成本自动记账。</p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><Fragment set:html={featureIcons.chart} /></span>
        <h3 class="feature-title">图表通用层</h3>
        <p class="feature-desc">一份 JSON，十二种图。悬停、点击、右键与图例开关全部内建，不依赖任何图表库。</p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><Fragment set:html={featureIcons.layers} /></span>
        <h3 class="feature-title">三层正交</h3>
        <p class="feature-desc">色彩、质感、明暗三层分开调，互不影响。{COMPONENTS.length} 个组件消费同一套令牌，换肤零改动。</p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><Fragment set:html={featureIcons.box} /></span>
        <h3 class="feature-title">零依赖无框架</h3>
        <p class="feature-desc">零运行时依赖，不挑框架：React、Vue、原生 JS 都行，SSR 安全。</p>
      </div>
    </div>
  </section>

  <!-- ═══ 分组导航带 ═══ -->
  <section class="groups" aria-label="组件分组">
    {GROUPS.map((g) => (
      <a class="group-card" href={`/components/${GROUP_LINK[g] ?? 'icen-btn'}/`}>
        <span class="group-name">{g}</span>
        <span class="group-count">{COMPONENTS.filter((c) => c.group === g).length}</span>
        <span class="group-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </section>

  <!-- ═══ 快速开始 ═══ -->
  <section class="quickstart" id="quickstart">
    <h2 class="qs-title">快速开始</h2>
    <div class="qs-step">
      <h3 class="qs-step-title"><span class="qs-num">1</span>安装</h3>
      <PmInstall />
    </div>
    <div class="qs-step">
      <h3 class="qs-step-title"><span class="qs-num">2</span>引入样式</h3>
      <CodeBlock code={importCss} lang="js" />
    </div>
    <div class="qs-step">
      <h3 class="qs-step-title"><span class="qs-num">3</span>选择预设与明暗</h3>
      <CodeBlock code={htmlPreset} lang="html" />
      <p class="doc-note" style="margin-top:8px">
        从 v0.9 升级？跑包内 codemod：<code>bunx @icen.ai/ui migrate src --write</code>（详见 <a href="/customize/">定制与迁移</a>）。
      </p>
    </div>
  </section>

  <script>
    import { renderCalendar, renderDonut, renderGauge, renderSparkline } from '../../../src/behaviors/charts.ts';
    import { renderAiMessage } from '../../../src/behaviors/ai-chat.ts';
    import { renderAiToolCall, initAiTool } from '../../../src/behaviors/ai-tool.ts';
    import { renderAiTodo, renderAiUsageRing } from '../../../src/behaviors/ai-panel.ts';
    import { initInput } from '../../../src/behaviors/input.ts';
    import { initSlider } from '../../../src/behaviors/slider.ts';
    import { initCopy } from '../../../src/behaviors/copy.ts';
    import { initTooltip } from '../../../src/behaviors/tooltip.ts';
    import { initSwitch } from '../../../src/behaviors/controls.ts';


    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    initInput();
    initSwitch();
    initSlider();
    initAiTool();
    initCopy();
    initTooltip();


    /* ── 统计卡：迷你趋势线 ── */
    const sparkEl = document.getElementById('mc-spark');
    if (sparkEl) renderSparkline(sparkEl, { values: [4, 6, 5, 8, 7, 9, 11, 10, 13, 12, 15, 14] });

    /* ── 贡献日历：确定性伪随机（近 63 天，dates+values 配对） ── */
    const calEl = document.getElementById('mc-cal');
    if (calEl) {
      const days = 63;
      const values = Array.from({ length: days }, (_, i) => {
        const base = Math.abs(Math.sin(i * 0.61)) * 7;
        const spike = i % 17 === 0 ? 8 : 0;
        const rest = i % 11 === 0 ? -99 : 0;
        return Math.max(0, Math.round(base + spike + rest));
      });
      const dates = Array.from({ length: days }, (_, i) =>
        new Date(Date.now() - (days - 1 - i) * 86400000).toISOString().slice(0, 10));
      renderCalendar(calEl, { dates, values });
    }

    /* ── AI 会话卡：用户提问 → 助手流式回复，固定高度循环播放（不挤兑群岛其他卡） ── */
    const chatEl = document.getElementById('mc-chat');
    if (chatEl) {
      const USER_TEXT = '看下能力曲线';
      const REPLY = '已渲染三系列折线，图例与悬停事件内建。';
      const timeouts = [];
      const intervals = [];
      const later = (fn, ms) => timeouts.push(setTimeout(fn, ms));
      const every = (fn, ms) => intervals.push(setInterval(fn, ms));
      const clearAll = () => {
        timeouts.splice(0).forEach(clearTimeout);
        intervals.splice(0).forEach(clearInterval);
      };

      function cycle() {
        clearAll();
        chatEl.textContent = '';
        if (document.hidden) { later(cycle, 4000); return; }
        const user = document.createElement('div');
        chatEl.append(user);
        renderAiMessage(user, { role: 'user', content: USER_TEXT });
        later(() => {
          const host = document.createElement('div');
          chatEl.append(host);
          const h = renderAiMessage(host, { role: 'assistant', model: 'kimi-k3', content: '' });
          const s = h.stream();
          let i = 0;
          every(() => {
            s.append(REPLY.slice(i, i + 2));
            i += 2;
            if (i >= REPLY.length) {
              clearAll();
              s.done();
              h.setMeta('刚刚 · 0.4k tok');
              later(cycle, 3600);
            }
          }, 34);
        }, 450);
      }

      if (reducedMotion) {
        const user = document.createElement('div');
        chatEl.append(user);
        renderAiMessage(user, { role: 'user', content: USER_TEXT });
        const host = document.createElement('div');
        chatEl.append(host);
        renderAiMessage(host, { role: 'assistant', model: 'kimi-k3', content: REPLY, meta: '刚刚 · 0.4k tok' });
      } else {
        cycle();
      }
    }

    /* ── 待办 + 上下文环 ── */
    const todoEl = document.getElementById('mc-todo');
    if (todoEl) renderAiTodo(todoEl, [
      { content: '提炼阶段叙事', status: 'done' },
      { content: '渲染能力可视化', status: 'running', activeForm: '正在渲染可视化' },
      { content: '写入 history.md', status: 'pending' },
    ]);
    const ringEl = document.getElementById('mc-ring');
    if (ringEl) renderAiUsageRing(ringEl, { input: 420000 }, { total: 1000000 });

        /* ── 环形占比（label 字段 + 图例百分比） ── */
    const donutEl = document.getElementById('mc-donut');
    if (donutEl) renderDonut(donutEl, {
      segments: [
        { label: '组件', value: 67, tone: 'accent' },
        { label: 'AI 原生', value: 13, tone: 'success' },
        { label: '图表类型', value: 12, tone: 'muted' },
      ],
    });

    /* ── 仪表盘：初始渲染后只改 dasharray / 数值（CSS 过渡平滑接管） ── */
    const gaugeEl = document.getElementById('mc-gauge');
    if (gaugeEl) {
      const GAUGE_R = 42;
      const CIRC = 2 * Math.PI * GAUGE_R;
      let gv = 72;
      renderGauge(gaugeEl, { value: gv, max: 100, label: '健康度' });
      if (!reducedMotion) {
        setInterval(() => {
          if (document.hidden) return;
          gv = Math.min(94, Math.max(58, gv + (Math.random() * 16 - 8)));
          const ratio = gv / 100;
          const arc = gaugeEl.querySelectorAll('svg circle')[1];
          if (arc) arc.setAttribute('stroke-dasharray', `${(ratio * CIRC).toFixed(1)} ${(CIRC - ratio * CIRC).toFixed(1)}`);
          const val = gaugeEl.querySelector('.icen-chart-gauge-value');
          if (val) val.textContent = `${Math.round(ratio * 100)}%`;
        }, 4000);
      }
    }

    /* ── AI 工具调用卡：静态完成态（默认折叠一行摘要，点击展开） ── */
    const toolEl = document.getElementById('mc-tool');
    if (toolEl) renderAiToolCall(toolEl, {
      id: 'mc-tc', name: 'WebSearch', kind: 'search', status: 'done',
      input: { query: 'icen ui 设计系统' }, output: '命中 24 条结果', durationMs: 1800,
    });

    /* ── 滑块读数回显 ── */
    const sliderEl = document.querySelector('.icen-slider-native');
    const sliderVal = document.getElementById('mc-slider-val');
    sliderEl?.addEventListener('input', () => {
      if (sliderVal) sliderVal.textContent = (sliderEl as HTMLInputElement).value;
    });

    /* ── 数字带：滚动入场计数（reduced-motion 直接落终值） ── */
    const statNums = document.querySelectorAll('.hero-stat b[data-icen-count]');
    const setFinal = (el) => { el.textContent = el.getAttribute('data-icen-count'); };
    if (reducedMotion || !('IntersectionObserver' in window)) {
      statNums.forEach(setFinal);
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          io.unobserve(en.target);
          const el = en.target;
          const target = parseInt(el.getAttribute('data-icen-count') || '0', 10);
          const t0 = performance.now();
          const dur = 1100;
          const tick = (t) => {
            const p = Math.min(1, (t - t0) / dur);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.4 });
      statNums.forEach((el) => io.observe(el));
    }

</script>
