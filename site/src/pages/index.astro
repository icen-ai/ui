      <h3 class="qs-step-title"><span class="qs-num">1</span>安装设计系统包</h3>
      <PmInstall />
    </div>
    <div class="qs-step">
      <h3 class="qs-step-title"><span class="qs-num">2</span>在入口引入 tokens 与全部组件样式</h3>
      <CodeBlock code={importCss} lang="js" />
    </div>
    <div class="qs-step">
      <h3 class="qs-step-title"><span class="qs-num">3</span>在 <code>&lt;html&gt;</code> 上挂预设与明暗类</h3>
      <CodeBlock code={htmlPreset} lang="html" />
    </div>
  </section>

  <script>
    import { renderCalendar, renderGauge, renderDonut, renderSparkline } from '../../../src/behaviors/charts.ts';
    import { renderAiMessage } from '../../../src/behaviors/ai-chat.ts';
    import { renderAiToolCall, initAiTool } from '../../../src/behaviors/ai-tool.ts';
    import { renderAiTodo, renderAiUsageRing } from '../../../src/behaviors/ai-panel.ts';
    import { initInput } from '../../../src/behaviors/input.ts';
    import { initSlider } from '../../../src/behaviors/slider.ts';
    import { initCopy } from '../../../src/behaviors/copy.ts';
    import { getTheme, setTheme } from '../../../src/behaviors/theme.ts';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    initInput();
    initSlider();
    initCopy();
    initAiTool();

    /* ── 统计卡：迷你趋势线 ── */
    const sparkEl = document.getElementById('mc-spark');
    if (sparkEl) renderSparkline(sparkEl, { values: [4, 6, 5, 8, 7, 9, 11, 10, 13, 12, 15, 14] });

    /* ── 环形占比卡（显式 tone 三色分段 + 图例百分比） ── */
    const donutEl = document.getElementById('mc-donut');
    if (donutEl) renderDonut(donutEl, {
      segments: [
        { name: '组件', value: 67, tone: 'accent' },
        { name: 'AI 原生', value: 13, tone: 'success' },
        { name: '图表类型', value: 12, tone: 'muted' },
      ],
    });

    /* ── 贡献日历：确定性伪随机（近 63 天，dates+values 配对） ── */
    const calEl = document.getElementById('mc-cal');
    if (calEl) {
      const days = 63;
      const values = Array.from({ length: days }, (_, i) => {
        const base = Math.abs(Math.sin(i * 0.61)) * 7;
        const spike = i % 17 === 0 ? 8 : 0;
        const rest = i % 11 === 0 ? -99 : 0;
        return Math.max(0, Math.round(base + spike + rest));
      });
      const dates = Array.from({ length: days }, (_, i) =>
        new Date(Date.now() - (days - 1 - i) * 86400000).toISOString().slice(0, 10));
      renderCalendar(calEl, { dates, values });
    }

    /* ── AI 会话卡：用户提问 → 助手流式回复，固定高度循环播放（不挤兑群岛其他卡） ── */
    const chatEl = document.getElementById('mc-chat');
    if (chatEl) {
      const USER_TEXT = '看下能力曲线';
      const REPLY = '已渲染三系列折线，图例与悬停事件内建。';
      const timeouts = [];
      const intervals = [];
      const later = (fn, ms) => timeouts.push(setTimeout(fn, ms));
      const every = (fn, ms) => intervals.push(setInterval(fn, ms));
      const clearAll = () => {
        timeouts.splice(0).forEach(clearTimeout);
        intervals.splice(0).forEach(clearInterval);
      };

      function cycle() {
        clearAll();
        chatEl.textContent = '';
        if (document.hidden) { later(cycle, 4000); return; }
        const user = document.createElement('div');
        chatEl.append(user);
        renderAiMessage(user, { role: 'user', content: USER_TEXT });
        later(() => {
          const host = document.createElement('div');
          chatEl.append(host);
          const h = renderAiMessage(host, { role: 'assistant', model: 'kimi-k3', content: '' });
          const s = h.stream();
          let i = 0;
          every(() => {
            s.append(REPLY.slice(i, i + 2));
            i += 2;
            if (i >= REPLY.length) {
              clearAll();
              s.done();
              h.setMeta('刚刚 · 0.4k tok');
              later(cycle, 3600);
            }
          }, 34);
        }, 450);
      }

      if (reducedMotion) {
        const user = document.createElement('div');
        chatEl.append(user);
        renderAiMessage(user, { role: 'user', content: USER_TEXT });
        const host = document.createElement('div');
        chatEl.append(host);
        renderAiMessage(host, { role: 'assistant', model: 'kimi-k3', content: REPLY, meta: '刚刚 · 0.4k tok' });
      } else {
        cycle();
      }
    }

    /* ── 待办 + 上下文环 ── */
    const todoEl = document.getElementById('mc-todo');
    if (todoEl) renderAiTodo(todoEl, [
      { content: '提炼阶段叙事', status: 'done' },
      { content: '渲染能力可视化', status: 'running', activeForm: '正在渲染可视化' },
      { content: '写入 history.md', status: 'pending' },
    ]);
    const ringEl = document.getElementById('mc-ring');
    if (ringEl) renderAiUsageRing(ringEl, { input: 420000 }, { total: 1000000 });

    /* ── 工具调用卡：静态完成态（默认折叠一行摘要，点击展开） ── */
    const toolEl = document.getElementById('mc-tool');
    if (toolEl) renderAiToolCall(toolEl, {
      id: 'mc-tc', name: 'WebSearch', kind: 'search', status: 'done',
      input: { query: 'icen ui 设计系统' }, output: '命中 24 条结果', durationMs: 1800,
    });

    /* ── 仪表盘卡：renderGauge 初始渲染后只改 dasharray / 数值（CSS 过渡平滑接管） ── */
    const gaugeEl = document.getElementById('mc-gauge');
    if (gaugeEl) {
      const GAUGE_R = 42;
      const CIRC = 2 * Math.PI * GAUGE_R;
      let gv = 72;
      renderGauge(gaugeEl, { value: gv, max: 100, label: '健康度' });
      if (!reducedMotion) {
        setInterval(() => {
          if (document.hidden) return;
          gv = Math.min(94, Math.max(58, gv + (Math.random() * 16 - 8)));
          const ratio = gv / 100;
          const arc = gaugeEl.querySelectorAll('svg circle')[1];
          if (arc) arc.setAttribute('stroke-dasharray', `${(ratio * CIRC).toFixed(1)} ${(CIRC - ratio * CIRC).toFixed(1)}`);
          const val = gaugeEl.querySelector('.chart-gauge-value');
          if (val) val.textContent = `${Math.round(ratio * 100)}%`;
        }, 4000);
      }
    }

    /* ── 纯 CSS 状态组件的演示接线（实际项目由使用方状态驱动） ── */
    document.querySelectorAll('.switch[role="switch"], .checkbox[role="checkbox"]').forEach((el) => {
      el.addEventListener('click', () => {
        el.setAttribute('aria-checked', el.getAttribute('aria-checked') === 'true' ? 'false' : 'true');
      });
    });

    /* ── 数字带：滚动入场计数（reduced-motion 直接落终值） ── */
    const statNums = document.querySelectorAll('.hero-stat b[data-count]');
    const setFinal = (el) => { el.textContent = el.getAttribute('data-count'); };
    if (reducedMotion || !('IntersectionObserver' in window)) {
      statNums.forEach(setFinal);
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          io.unobserve(en.target);
          const el = en.target;
          const target = parseInt(el.getAttribute('data-count') || '0', 10);
          const t0 = performance.now();
          const dur = 1100;
          const tick = (t) => {
            const p = Math.min(1, (t - t0) / dur);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.4 });
      statNums.forEach((el) => io.observe(el));
    }

    /* ── 指针视差：rAF 插值逼近，data-depth 决定景深（触屏/reduced-motion/窄屏关闭） ── */
    const stage = document.getElementById('stage');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches;
    if (stage && finePointer && !reducedMotion) {
      const layers = stage.querySelectorAll('[data-depth]');
      let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
      const step = () => {
        cx += (tx - cx) * 0.08;
        cy += (ty - cy) * 0.08;
        layers.forEach((layer) => {
          const d = parseFloat(layer.getAttribute('data-depth') || '10');
          layer.style.transform = `translate3d(${(-cx * d).toFixed(2)}px, ${(-cy * d).toFixed(2)}px, 0)`;
        });
        raf = (Math.abs(tx - cx) > 0.0006 || Math.abs(ty - cy) > 0.0006) ? requestAnimationFrame(step) : 0;
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(step); };
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        tx = (e.clientX - r.left) / r.width - 0.5;
        ty = (e.clientY - r.top) / r.height - 0.5;
        kick();
      });
      stage.addEventListener('pointerleave', () => { tx = 0; ty = 0; kick(); });
    }

    /* ── 预设色板：点击换肤 + 双向同步（头部 select 换肤时经 MutationObserver 回同步色板） ── */
    const presetChips = document.querySelectorAll('.preset-chip[data-preset]');
    const reflectPreset = (p) => {
      presetChips.forEach((c) => {
        const on = c.getAttribute('data-preset') === p;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    };
    reflectPreset(getTheme().preset);
    presetChips.forEach((c) => c.addEventListener('click', () => {
      const p = c.getAttribute('data-preset');
      if (!p) return;
      setTheme({ preset: p });
      reflectPreset(p);
      /* 同步头部 preset select 的展示态（复用其 change 监听，幂等） */
      const input = document.querySelector('#preset-select input[data-select-value]');
      if (input && input.value !== p) {
        input.value = p;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }));
    new MutationObserver(() => reflectPreset(getTheme().preset))
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  </script>
</Base>

