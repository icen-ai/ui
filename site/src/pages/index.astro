---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import PmInstall from '../components/PmInstall.astro';
import { COMPONENTS, GROUPS } from '../lib/components';
import pkg from '../../../package.json';

import '../../../src/components/input.css';
import '../../../src/components/form.css';
import '../../../src/components/switch.css';
import '../../../src/components/feedback.css';
import '../../../src/components/media.css';
import '../../../src/components/charts.css';
import '../../../src/components/chart-line.css';
import '../../../src/components/ai-chat.css';
import '../../../src/components/ai-tool.css';
import '../../../src/components/ai-panel.css';

/* 分组导航带：每组链接到伞页面 / 代表组件页 */
const GROUP_LINK: Record<string, string> = {
  '基础': 'btn', 'AI 原生': 'ai-overview', '表单': 'form', '数据展示': 'card',
  '图表': 'charts', '浮层': 'modal', '反馈': 'alert', '导航': 'nav',
};

const importCss = `import '@icen.ai/ui/tokens.css';
import '@icen.ai/ui/ui.css';`;
const htmlPreset = `<html class="piano dark"> … </html>`;
---

<Base title="ICEN UI · 为 AI 时代而生的设计系统">
  <!-- ═══ Hero ═══ -->
  <section class="hero">
    <a class="hero-pill" href="/components/ai-overview/">
      <span class="hero-pill-badge">v{pkg.version}</span>
      <span>AI 原生组件族 · 图表通用层 · 工具体系已发布</span>
      <span class="hero-pill-arrow" aria-hidden="true">→</span>
    </a>
    <h1 class="hero-title">设计系统<br />为 AI 时代而生</h1>
    <p class="hero-sub">
      设计 tokens（6 预设 × 明暗）+ 无框架组件 + AI 原生族（7 态状态机 / 多模态 / 定价审计）
      + 图表通用层（ChartSpec 纯 JSON）。全部消费同一套 <code>--token-*</code>，换肤零改动；
      UI 能力可注册为模型直接调用的工具。
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#quickstart">开始使用</a>
      <a class="btn" href="/components/">浏览 {COMPONENTS.length} 个组件</a>
    </div>

    <!-- 数字带：一眼看清规模 -->
    <div class="hero-stats" role="list">
      <div class="hero-stat" role="listitem"><b>78</b><span>kit 入口</span></div>
      <div class="hero-stat" role="listitem"><b>33</b><span>行为模块</span></div>
      <div class="hero-stat" role="listitem"><b>12</b><span>图表类型</span></div>
      <div class="hero-stat" role="listitem"><b>11</b><span>AI 原生</span></div>
      <div class="hero-stat" role="listitem"><b>0</b><span>运行时依赖</span></div>
    </div>
  </section>

  <!-- ═══ 悬浮拼贴：真实组件漂浮在画布上（hover 抬升） ═══ -->
  <section class="float-stage" aria-label="精选组件">
    <div class="float-grid">
      <article class="float-card float-card--xl">
        <span class="float-cap">数据可视化 · renderChart <em>ChartSpec 纯 JSON · 图例眼睛 · 六类交互事件</em></span>
        <div class="float-body" id="home-chart"></div>
      </article>

      <article class="float-card float-card--chat">
        <span class="float-cap">AI 会话 · renderAiMessage <em>多模态消息 + 工具调用卡</em></span>
        <div class="float-body float-body--col" id="home-ai"></div>
      </article>

      <article class="float-card float-card--lift">
        <span class="float-cap">贡献日历 · renderCalendar <em>GitHub 同款热力</em></span>
        <div class="float-body" id="home-calendar"></div>
      </article>

      <article class="float-card">
        <span class="float-cap">AI 状态 · 待办 + 上下文环 <em>业界模式三处同源</em></span>
        <div class="float-body float-body--split">
          <div id="home-todo"></div>
          <div id="home-ring" class="float-ring"></div>
        </div>
      </article>

      <article class="float-card float-card--ctrl">
        <span class="float-cap">控件</span>
        <div class="float-body float-body--col">
          <div class="demo-row">
            <button class="switch" type="button" role="switch" aria-checked="true" aria-label="自动发布"><span class="switch-thumb"></span></button>
            <button class="switch" type="button" role="switch" aria-checked="false" aria-label="预览环境"><span class="switch-thumb"></span></button>
            <span class="pill pill--success">运行中</span>
            <span class="pill pill--warning">排队</span>
          </div>
          <div class="demo-row">
            <button class="checkbox focus-ring" type="button" role="checkbox" aria-checked="false" aria-label="未选中"></button>
            <button class="checkbox focus-ring" type="button" role="checkbox" aria-checked="true" aria-label="已选中"></button>
            <button class="checkbox focus-ring" type="button" role="checkbox" aria-checked="mixed" aria-label="半选"></button>
          </div>
        </div>
      </article>

      <article class="float-card">
        <span class="float-cap">构建状态</span>
        <div class="float-body float-body--col build">
          <div class="build-row">
            <span class="pill pill--success">运行中</span>
            <span class="build-text">gateway · 3 分钟前</span>
            <span class="spinner spinner--sm"></span>
          </div>
          <div class="progress">
            <div class="progress-track"><div class="progress-bar" style="width:64%"></div></div>
            <span class="progress-label">64%</span>
          </div>
        </div>
      </article>

      <article class="float-card">
        <span class="float-cap">支付表单</span>
        <div class="float-body float-body--col pay">
          <label class="pay-field">
            <span class="pay-label">持卡人姓名</span>
            <div class="input-wrap control"><input class="input" placeholder="张三" /></div>
          </label>
          <div class="pay-row">
            <label class="pay-field pay-field--grow">
              <span class="pay-label">卡号</span>
              <div class="input-wrap control"><input class="input" placeholder="1234 5678 9012 3456" /></div>
            </label>
            <label class="pay-field pay-field--cvv">
              <span class="pay-label">CVV</span>
              <div class="input-wrap control"><input class="input" placeholder="123" /></div>
            </label>
          </div>
          <div class="pay-actions">
            <button class="btn btn-primary btn-sm" type="button">提交</button>
            <button class="btn btn-sm" type="button">取消</button>
          </div>
        </div>
      </article>

      <article class="float-card float-card--team">
        <span class="float-cap">协作</span>
        <div class="float-body team">
          <div class="team-avatars">
            <span class="avatar" style="background:#d97757;color:#fff">林</span>
            <span class="avatar">沈</span>
            <span class="avatar">顾</span>
          </div>
          <p class="team-title">暂无团队成员</p>
          <p class="team-desc">邀请你的团队协作完成此项目。</p>
          <button class="btn btn-sm" type="button">＋ 邀请成员</button>
        </div>
      </article>
    </div>
  </section>

  <!-- ═══ 分组导航带 ═══ -->
  <section class="groups" aria-label="组件分组">
    {GROUPS.map((g) => (
      <a class="group-card" href={`/components/${GROUP_LINK[g] ?? 'btn'}/`}>
        <span class="group-name">{g}</span>
        <span class="group-count">{COMPONENTS.filter((c) => c.group === g).length}</span>
        <span class="group-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </section>

  <!-- ═══ 特性 ═══ -->
  <section class="features">
    <div class="feature">
      <h3 class="feature-title">AI 原生族</h3>
      <p class="feature-desc">7 态状态机 + 多模态内容模型（对标 AI SDK v5 / MCP / OpenAI / Anthropic）+ 定价审计闭环，零接线一行绑定。</p>
    </div>
    <div class="feature">
      <h3 class="feature-title">图表通用层</h3>
      <p class="feature-desc"><code>renderChart</code> 吃纯 JSON ChartSpec，12 种图；悬停 / 单击 / 双击 / 右键事件与图例眼睛内建。</p>
    </div>
    <div class="feature">
      <h3 class="feature-title">三层正交</h3>
      <p class="feature-desc">色彩预设 × 风格 profile × 明暗，三层互不耦合；{COMPONENTS.length} 个组件共享同一套 <code>--token-*</code>，换肤零改动。</p>
    </div>
    <div class="feature">
      <h3 class="feature-title">零依赖无框架</h3>
      <p class="feature-desc">纯 CSS class 契约 + 按需 behavior JS，SSR 安全；React / Vue / 原生都能接，类型面（.d.mts）随包发布。</p>
    </div>
  </section>

  <!-- ═══ 快速开始 ═══ -->
  <section class="quickstart" id="quickstart">
    <h2 class="qs-title">快速开始</h2>
    <div class="qs-step">
      <h3 class="qs-step-title"><span class="qs-num">1</span>安装设计系统包</h3>
      <PmInstall />
    </div>
    <div class="qs-step">
      <h3 class="qs-step-title"><span class="qs-num">2</span>在入口引入 tokens 与全部组件样式</h3>
      <CodeBlock code={importCss} lang="js" />
    </div>
    <div class="qs-step">
      <h3 class="qs-step-title"><span class="qs-num">3</span>在 <code>&lt;html&gt;</code> 上挂预设与明暗类</h3>
      <CodeBlock code={htmlPreset} lang="html" />
    </div>
  </section>

  <script>
    import { renderChart, renderCalendar } from '../../../src/behaviors/charts.ts';
    import { renderAiMessage } from '../../../src/behaviors/ai-chat.ts';
    import { renderAiToolCall, initAiTool } from '../../../src/behaviors/ai-tool.ts';
    import { renderAiTodo, renderAiUsageRing } from '../../../src/behaviors/ai-panel.ts';
    import { initInput } from '../../../src/behaviors/input.ts';
    import { initCopy } from '../../../src/behaviors/copy.ts';

    initInput();
    initCopy();
    initAiTool();

    /* 门面图表：与 AI 总览同数据（v0.1 → v0.8 能力数，多系列折线） */
    const chartEl = document.getElementById('home-chart');
    if (chartEl) renderChart(chartEl, {
      type: 'line',
      labels: ['v0.1', 'v0.2', 'v0.3', 'v0.4', 'v0.5', 'v0.6', 'v0.7', 'v0.8'],
      series: [
        { name: '组件', values: [31, 41, 43, 47, 51, 55, 66, 67] },
        { name: 'AI 专属', values: [0, 0, 0, 0, 0, 0, 11, 13] },
        { name: '图表类型', values: [1, 5, 10, 10, 10, 10, 10, 12] },
      ],
    });

    /* AI 会话卡：一条多模态消息 + 一张已完成的工具调用卡 */
    const aiEl = document.getElementById('home-ai');
    if (aiEl) {
      const msg = document.createElement('div');
      renderAiMessage(msg, {
        role: 'assistant', model: 'kimi-k3',
        content: '能力曲线已就绪：四幕叙事 + 多系列折线，写入 history.md 前待你确认。',
        meta: '刚刚 · 1.1k tok',
      });
      const tool = document.createElement('div');
      renderAiToolCall(tool, {
        id: 'home-tc', name: 'render_chart', kind: 'chart', status: 'done',
        input: { type: 'line', series: '×3' }, output: '已渲染 → 右上「数据可视化」卡',
        durationMs: 240,
      });
      aiEl.append(msg, tool);
    }

    /* 贡献日历：确定性伪随机（近 182 天，dates+values 配对） */
    const calEl = document.getElementById('home-calendar');
    if (calEl) {
      const days = 182;
      const values = Array.from({ length: days }, (_, i) => {
        const base = Math.abs(Math.sin(i * 0.61)) * 7;
        const spike = i % 17 === 0 ? 8 : 0;
        const rest = i % 11 === 0 ? -99 : 0;
        return Math.max(0, Math.round(base + spike + rest));
      });
      const dates = Array.from({ length: days }, (_, i) =>
        new Date(Date.now() - (days - 1 - i) * 86400000).toISOString().slice(0, 10));
      renderCalendar(calEl, { dates, values });
    }

    /* AI 状态卡：待办（3/5）+ 上下文环（42%） */
    const todoEl = document.getElementById('home-todo');
    if (todoEl) renderAiTodo(todoEl, [
      { content: '搜集公开迭代资料', status: 'done' },
      { content: '拉取内部发布记录', status: 'done' },
      { content: '提炼阶段叙事与数据', status: 'done' },
      { content: '渲染能力增长可视化', status: 'running', activeForm: '正在渲染能力增长可视化' },
      { content: '写入 docs/history.md', status: 'pending' },
    ]);
    const ringEl = document.getElementById('home-ring');
    if (ringEl) renderAiUsageRing(ringEl, { input: 420000 }, { total: 1000000 });

    /* 纯 CSS 状态组件的演示接线（实际项目由使用方状态驱动） */
    document.querySelectorAll('.switch[role="switch"], .checkbox[role="checkbox"]').forEach((el) => {
      el.addEventListener('click', () => {
        el.setAttribute('aria-checked', el.getAttribute('aria-checked') === 'true' ? 'false' : 'true');
      });
    });
  </script>
</Base>

<style is:global>
  /* ═══ Hero ═══ */
  .hero { padding: 88px 0 24px; text-align: center; }
  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 5px;
    border: 1px solid var(--token-line-soft);
    border-radius: var(--radius-full);
    background: var(--token-surface);
    color: var(--token-text-muted);
    font-size: 12.5px;
    transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .hero-pill:hover { border-color: var(--token-accent); color: var(--token-text); text-decoration: none; }
  .hero-pill-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--token-surface);
    background: var(--token-accent);
    border-radius: var(--radius-full);
    padding: 2px 8px;
  }
  .hero-pill-arrow { color: var(--token-text-faint); }
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6.4vw, 64px);
    font-weight: 700;
    letter-spacing: 3px;
    line-height: 1.2;
    margin: 28px 0 18px;
  }
  .hero-sub {
    color: var(--token-text-muted);
    font-size: 15px;
    line-height: 1.9;
    max-width: 680px;
    margin: 0 auto 32px;
  }
  .hero-actions { display: flex; justify-content: center; gap: 12px; }
  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 48px;
    margin-top: 48px;
    padding: 18px 0 0;
    border-top: 1px solid var(--token-line-soft);
  }
  .hero-stat { display: flex; align-items: baseline; gap: 8px; }
  .hero-stat b { font-family: var(--font-mono); font-size: 26px; font-weight: 700; color: var(--token-text); }
  .hero-stat span { font-size: 12px; color: var(--token-text-faint); letter-spacing: 1px; }

  /* ═══ 悬浮拼贴（参考 Vuesax 式组件漂浮画布，全部为实时渲染的真组件） ═══ */
  .float-stage { padding: 56px 0 8px; }
  .float-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 22px;
  }
  .float-card {
    --float-shadow: 0 1px 2px rgba(28,25,23,.05), 0 18px 44px -14px rgba(28,25,23,.16);
    --float-shadow-hover: 0 2px 4px rgba(28,25,23,.06), 0 30px 68px -18px rgba(28,25,23,.24);
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 1px solid var(--token-line-soft);
    border-radius: 20px;
    background: var(--token-surface);
    padding: 18px 20px 20px;
    box-shadow: var(--float-shadow);
    transition:
      transform var(--duration-mid, 240ms) var(--ease-out),
      box-shadow var(--duration-mid, 240ms) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
    will-change: transform;
  }
  .dark .float-card {
    --float-shadow: 0 1px 2px rgba(0,0,0,.4), 0 18px 44px -14px rgba(0,0,0,.55);
    --float-shadow-hover: 0 2px 4px rgba(0,0,0,.45), 0 30px 68px -18px rgba(0,0,0,.7);
  }
  @media (hover: hover) and (pointer: fine) {
    /* hover 只加深投影与层级，不抢 transform —— 呼吸漂浮不因指针打断 */
    .float-card:hover {
      box-shadow: var(--float-shadow-hover);
      border-color: var(--token-line);
      z-index: 3;
    }
  }
  .float-card--xl { grid-column: span 7; }
  .float-card--chat { grid-column: span 5; }
  .float-card--lift { grid-column: span 5; margin-top: -40px; z-index: 2; }
  .float-card--ctrl { grid-column: span 3; }
  .float-card--team .float-body { align-items: center; }
  .float-cap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--token-text-muted);
  }
  .float-cap em {
    font-style: normal;
    font-weight: 400;
    font-size: 10.5px;
    color: var(--token-text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .float-body { flex: 1; min-width: 0; }
  .float-body--col { display: flex; flex-direction: column; gap: 12px; }
  .float-body--split { display: flex; align-items: center; gap: 16px; }
  .float-body--split > #home-todo { flex: 1; min-width: 0; }
  .float-ring { flex: none; }

  /* 进场 + 持续呼吸漂浮：入场（一次性）之后接无限 levitate（每卡不同时长/相位，有机错落）。
     levitate 用正延迟等入场结束再接管 transform，两段动画不冲突；动效守卫下全部关闭。 */
  @media (prefers-reduced-motion: no-preference) {
    .float-card {
      --lev-duration: 6.5s;
      --lev-delay: 1s;
      animation:
        float-in .55s var(--ease-out) backwards,
        levitate var(--lev-duration) ease-in-out var(--lev-delay) infinite;
    }
    .float-card:nth-child(1) { --lev-duration: 6.4s; --lev-delay: .75s; }
    .float-card:nth-child(2) { --lev-duration: 7.6s; --lev-delay: 1.0s; }
    .float-card:nth-child(3) { --lev-duration: 5.9s; --lev-delay: 1.25s; }
    .float-card:nth-child(4) { --lev-duration: 7.0s; --lev-delay: .9s; }
    .float-card:nth-child(5) { --lev-duration: 6.1s; --lev-delay: 1.15s; }
    .float-card:nth-child(6) { --lev-duration: 8.0s; --lev-delay: 1.4s; }
    .float-card:nth-child(7) { --lev-duration: 6.8s; --lev-delay: 1.05s; }
    .float-card:nth-child(8) { --lev-duration: 7.3s; --lev-delay: 1.3s; }
    @keyframes float-in {
      from { opacity: 0; transform: translateY(22px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes levitate {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-7px); }
    }
  }

  /* ═══ 分组导航带 ═══ */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    padding: 48px 0 8px;
  }
  .group-card {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 16px;
    border: 1px solid var(--token-line-soft);
    border-radius: var(--radius-lg);
    background: var(--token-surface);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .group-card:hover { border-color: var(--token-accent); transform: translateY(-2px); }
  .group-name { font-size: 13.5px; font-weight: 600; color: var(--token-text); }
  .group-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--token-text-faint);
    background: var(--token-bg-soft);
    border: 1px solid var(--token-line-soft);
    border-radius: var(--radius-full);
    padding: 1px 7px;
  }
  .group-arrow { margin-left: auto; color: var(--token-text-faint); font-size: 12px; }
  .group-card:hover .group-arrow { color: var(--token-accent); }

  /* 拼贴内复用的旧卡内容 */
  .pay { display: flex; flex-direction: column; gap: 12px; }
  .pay-field { display: flex; flex-direction: column; gap: 5px; }
  .pay-field--grow { flex: 1; }
  .pay-field--cvv { width: 84px; }
  .pay-label { font-size: 12px; color: var(--token-text-muted); }
  .pay-row { display: flex; gap: 10px; }
  .pay-actions { display: flex; gap: 8px; margin-top: 2px; }
  .team { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 6px 0; }
  .team-avatars { display: flex; margin-bottom: 6px; }
  .team-avatars .avatar { margin-left: -8px; box-shadow: 0 0 0 2px var(--token-surface); }
  .team-avatars .avatar:first-child { margin-left: 0; }
  .team-title { font-size: 14px; font-weight: 600; margin: 0; }
  .team-desc { font-size: 12px; color: var(--token-text-muted); margin: 0 0 6px; }
  .build { display: flex; flex-direction: column; gap: 12px; }
  .build-row { display: flex; align-items: center; gap: 10px; }
  .build-row .spinner { margin-left: auto; }
  .build-text { font-size: 12px; color: var(--token-text-muted); }

  /* ═══ 特性 ═══ */
  .features {
