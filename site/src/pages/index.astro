---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import PmInstall from '../components/PmInstall.astro';
import { COMPONENTS, GROUPS } from '../lib/components';
import pkg from '../../../package.json';

import '../../../src/components/input.css';
import '../../../src/components/switch.css';
import '../../../src/components/feedback.css';
import '../../../src/components/media.css';
import '../../../src/components/content.css';
import '../../../src/components/slider.css';
import '../../../src/components/tag.css';
import '../../../src/components/charts.css';
import '../../../src/components/chart-heatmap.css';
import '../../../src/components/chart-gauge.css';
import '../../../src/components/chart-sparkline.css';
import '../../../src/components/chart-pie.css';
import '../../../src/components/ai-chat.css';
import '../../../src/components/ai-tool.css';
import '../../../src/components/ai-panel.css';

/* 分组导航带：每组链接到伞页面 / 代表组件页 */
const GROUP_LINK: Record<string, string> = {
  '基础': 'btn', 'AI 原生': 'ai-overview', '表单': 'form', '数据展示': 'card',
  '图表': 'charts', '浮层': 'modal', '反馈': 'alert', '导航': 'nav',
};

/* 预设色板：展示内容为各预设自身的基值（色值即数据，非 UI 样式） */
const PRESET_SWATCHES = [
  { id: 'clay',    name: 'clay 陶土',    bg: '#faf9f5', accent: '#d97757', cold: '#7a9cb0' },
  { id: 'piano',   name: 'piano 钢琴',   bg: '#f1eee6', accent: '#b89145', cold: '#566370' },
  { id: 'art',     name: 'art 艺术',     bg: '#dce8e3', accent: '#d66f4f', cold: '#4f8f90' },
  { id: 'vangogh', name: 'vangogh 梵高', bg: '#e8ddb2', accent: '#1f527c', cold: '#476f45' },
  { id: 'ink',     name: 'ink 墨',       bg: '#f5f2ed', accent: '#5b7a5e', cold: '#6b7e8a' },
  { id: 'retro',   name: 'retro 复古',   bg: '#f0f0e8', accent: '#d03030', cold: '#3030a0' },
] as const;

const importCss = `import '@icen.ai/ui/tokens.css';
import '@icen.ai/ui/ui.css';`;
const htmlPreset = `<html class="piano dark"> … </html>`;

const copySvg = `<svg class="ic-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>`;
const checkSvg = `<svg class="ic-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
const searchSvg = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`;
const starSvg = `<svg viewBox="0 0 24 24" stroke-linejoin="round"><path d="M12 2.5l2.95 6.26 6.85.72-5.1 4.63 1.4 6.74L12 17.6l-6.1 3.25 1.4-6.74-5.1-4.63 6.85-.72z"/></svg>`;
const rocketSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`;
const featureIcons = {
  ai: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/></svg>`,
  chart: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg>`,
  layers: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>`,
  box: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/></svg>`,
};
const presetCheckSvg = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
---

<Base title="ICEN UI · 为 AI 时代而生的设计系统">
  <!-- ═══ Hero（背景全宽出血） ═══ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-orb hero-orb--a"></span>
      <span class="hero-orb hero-orb--b"></span>
      <span class="hero-orb hero-orb--c"></span>
      <span class="hero-grid"></span>
    </div>
    <div class="hero-inner">
      <a class="hero-pill fade-up" href="/components/ai-overview/">
        <span class="hero-pill-dot" aria-hidden="true"></span>
        <span class="hero-pill-badge">v{pkg.version}</span>
        <span>AI 原生组件族 · 图表通用层已发布</span>
        <span class="hero-pill-arrow" aria-hidden="true">→</span>
      </a>
      <h1 class="hero-title">
        <span class="reveal-line"><span>设计系统，</span></span>
        <span class="reveal-line"><span>为 <em class="hero-grad">AI 时代</em> 而生</span></span>
      </h1>
      <p class="hero-sub fade-up fade-up--2">
        设计 tokens（6 预设 × 明暗）× 无框架组件 × AI 原生族（7 态状态机 / 多模态 / 定价审计）
        × 图表通用层（ChartSpec 纯 JSON）。全部消费同一套 <code>--token-*</code>，换肤零改动；
        UI 能力可直接注册为模型调用的工具。
      </p>
      <div class="hero-actions fade-up fade-up--3">
        <a class="btn btn-primary btn-lg" href="#quickstart">开始使用</a>
        <a class="btn btn-lg" href="/components/">浏览 {COMPONENTS.length} 个组件</a>
        <span class="install-chip">
          <span class="install-prompt" aria-hidden="true">$</span>
          <code class="install-cmd">bun add @icen.ai/ui</code>
          <button class="copy-btn install-copy" type="button" data-copy="bun add @icen.ai/ui" data-copy-icon aria-label="复制安装命令">
            <Fragment set:html={copySvg + checkSvg} />
          </button>
        </span>
      </div>

      <!-- 数字带：一眼看清规模（滚动入场时计数） -->
      <div class="hero-stats fade-up fade-up--4" role="list">
        <div class="hero-stat" role="listitem"><b data-count={COMPONENTS.length}>0</b><span>kit 入口</span></div>
        <div class="hero-stat" role="listitem"><b data-count="33">0</b><span>行为模块</span></div>
        <div class="hero-stat" role="listitem"><b data-count="12">0</b><span>图表类型</span></div>
        <div class="hero-stat" role="listitem"><b data-count="11">0</b><span>AI 原生</span></div>
        <div class="hero-stat" role="listitem"><b data-count="0">0</b><span>运行时依赖</span></div>
      </div>
    </div>
  </section>

  <!-- ═══ 袖珍组件群岛：19 个真实组件迷你卡，手工排布成有机云状（视差 × 呼吸 × 抬升三层变换互不冲突） ═══ -->
  <section class="stage-sec" aria-label="精选组件">
    <div class="sec-head">
      <p class="sec-over"><span class="sec-over-dot" aria-hidden="true"></span>SHOWCASE · 精选组件</p>
      <h2 class="sec-title">先体验，再安装</h2>
      <p class="sec-desc">这里没有一个截图 —— 每个组件都由 @icen.ai/ui 当场渲染，可以直接点击、拖动、输入。悬停任意卡片查看组件名。</p>
    </div>
    <div class="stage" id="stage">
      <span class="stage-glow" aria-hidden="true"></span>
      <span class="stage-orbit" aria-hidden="true"></span>
      <div class="f-canvas">

        <div class="f-cell" data-depth="14" data-label="统计 + 迷你趋势线 · stat / sparkline" style="left:27%;top:1%">
          <div class="f-lev" style="--in-delay:.05s;--lev-duration:7.4s;--lev-delay:1.1s">
            <article class="mini-card" style="--w:180px">
              <p class="mn-label">周活跃用户</p>
              <div class="mn-stat-row"><b class="mn-num">8,642</b><span class="pill pill--success">+12.4%</span></div>
              <div id="mc-spark"></div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="8" data-label="贡献日历 · renderCalendar" style="left:46%;top:0%">
          <div class="f-lev" style="--in-delay:.11s;--lev-duration:6.8s;--lev-delay:.8s">
            <article class="mini-card" style="--w:190px">
              <div id="mc-cal"></div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="11" data-label="环形占比 · renderDonut" style="left:64%;top:4%">
          <div class="f-lev" style="--in-delay:.17s;--lev-duration:6.2s;--lev-delay:1.3s">
            <article class="mini-card" style="--w:200px">
              <div id="mc-donut"></div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="18" data-label="开关 · switch" style="left:79%;top:2%">
          <div class="f-lev" style="--in-delay:.23s;--lev-duration:5.9s;--lev-delay:1s">
            <article class="mini-card" style="--w:110px">
              <div class="mn-row"><button class="switch switch--sm" type="button" role="switch" aria-checked="true" aria-label="自动发布"><span class="switch-thumb"></span></button><span class="mn-lb">自动</span></div>
              <div class="mn-row"><button class="switch switch--sm" type="button" role="switch" aria-checked="false" aria-label="预览"><span class="switch-thumb"></span></button><span class="mn-lb">预览</span></div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="22" data-label="仪表盘 · renderGauge 轮询" style="left:90%;top:14%">
          <div class="f-lev" style="--in-delay:.29s;--lev-duration:8.1s;--lev-delay:1.45s">
            <article class="mini-card" style="--w:130px">
              <div class="mn-gauge">
                <div id="mc-gauge"></div>
                <span class="pill pill--success gauge-live"><span class="live-dot" aria-hidden="true"></span>LIVE</span>
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="16" data-label="通知 · notification" style="left:3%;top:8%">
          <div class="f-lev" style="--in-delay:.35s;--lev-duration:6.4s;--lev-delay:.9s">
            <article class="mini-card" style="--w:220px">
              <div class="mn-row mn-row--top">
                <span class="mn-ic" aria-hidden="true"><Fragment set:html={rocketSvg} /></span>
                <div class="mn-main">
                  <p class="mn-t">部署成功 <span class="pill pill--success">新</span></p>
                  <p class="mn-d">gateway · 32 秒前</p>
                </div>
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="10" data-label="待办 + 上下文环 · ai-todo / ai-usage" style="left:12%;top:28%">
          <div class="f-lev" style="--in-delay:.41s;--lev-duration:6.6s;--lev-delay:1.05s">
            <article class="mini-card" style="--w:220px">
              <div class="mn-split">
                <div id="mc-todo"></div>
                <div id="mc-ring" class="mn-ring"></div>
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="6" data-label="AI 会话 · renderAiMessage 流式" style="left:37%;top:22%">
          <div class="f-lev" style="--in-delay:.47s;--lev-duration:7.1s;--lev-delay:1.2s">
            <article class="mini-card" style="--w:230px">
              <div class="mc-chat" id="mc-chat"></div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="20" data-label="状态徽章 · pill" style="left:60%;top:26%">
          <div class="f-lev" style="--in-delay:.53s;--lev-duration:5.7s;--lev-delay:1.35s">
            <article class="mini-card" style="--w:150px">
              <div class="mn-wrap">
                <span class="pill pill--success">稳定</span>
                <span class="pill pill--warning">排队</span>
                <span class="pill pill--error">失败</span>
                <span class="pill pill--info">Beta</span>
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="24" data-label="搜索输入 · input" style="left:76%;top:32%">
          <div class="f-lev" style="--in-delay:.59s;--lev-duration:7.6s;--lev-delay:.95s">
            <article class="mini-card" style="--w:190px">
              <div class="input-wrap control input-wrap--sm">
                <span class="input-leading"><Fragment set:html={searchSvg} /></span>
                <input class="input" placeholder="搜索组件…" aria-label="搜索组件" />
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="26" data-label="头像组 · avatar" style="left:90%;top:40%">
          <div class="f-lev" style="--in-delay:.65s;--lev-duration:7.8s;--lev-delay:1.4s">
            <article class="mini-card" style="--w:150px">
              <div class="mn-row">
                <span class="mn-avatars">
                  <span class="avatar" style="background:#d97757;color:#fff">林</span>
                  <span class="avatar">沈</span>
                  <span class="avatar">顾</span>
                </span>
                <span class="mn-lb"><span class="mn-dot" aria-hidden="true"></span>5 位</span>
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="9" data-label="工具调用 · renderAiToolCall" style="left:8%;top:52%">
          <div class="f-lev" style="--in-delay:.71s;--lev-duration:6.1s;--lev-delay:1.25s">
            <article class="mini-card" style="--w:210px">
              <div id="mc-tool"></div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="17" data-label="评分 · rating" style="left:30%;top:48%">
          <div class="f-lev" style="--in-delay:.77s;--lev-duration:7.2s;--lev-delay:1.5s">
            <article class="mini-card" style="--w:160px">
              <div class="rating" role="group" aria-label="评分 4.5 星，满分 5 星">
                <button class="rating-star is-filled" type="button" aria-label="1 星"><Fragment set:html={starSvg} /></button>
                <button class="rating-star is-filled" type="button" aria-label="2 星"><Fragment set:html={starSvg} /></button>
                <button class="rating-star is-filled" type="button" aria-label="3 星"><Fragment set:html={starSvg} /></button>
                <button class="rating-star is-filled" type="button" aria-label="4 星"><Fragment set:html={starSvg} /></button>
                <button class="rating-star is-half" type="button" aria-label="5 星"><Fragment set:html={starSvg} /></button>
              </div>
              <p class="mn-d" style="margin:7px 0 0">4.5 · 128 条评价</p>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="13" data-label="进度 · progress" style="left:50%;top:52%">
          <div class="f-lev" style="--in-delay:.83s;--lev-duration:6.3s;--lev-delay:.85s">
            <article class="mini-card" style="--w:180px">
              <p class="mn-label">构建中</p>
              <div class="progress">
                <div class="progress-track"><div class="progress-bar" style="width:64%"></div></div>
                <span class="progress-label">64%</span>
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="19" data-label="复选 · checkbox" style="left:68%;top:50%">
          <div class="f-lev" style="--in-delay:.89s;--lev-duration:6.9s;--lev-delay:1.15s">
            <article class="mini-card" style="--w:140px">
              <div class="mn-row"><button class="checkbox focus-ring" type="button" role="checkbox" aria-checked="true" aria-label="全量"></button><span class="mn-lb">全量</span></div>
              <div class="mn-row"><button class="checkbox focus-ring" type="button" role="checkbox" aria-checked="mixed" aria-label="增量"></button><span class="mn-lb">增量</span></div>
              <div class="mn-row"><button class="checkbox focus-ring" type="button" role="checkbox" aria-checked="false" aria-label="跳过"></button><span class="mn-lb">跳过</span></div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="21" data-label="快捷键 · kbd" style="left:84%;top:58%">
          <div class="f-lev" style="--in-delay:.95s;--lev-duration:5.8s;--lev-delay:1.3s">
            <article class="mini-card" style="--w:120px">
              <div class="mn-row mn-row--center">
                <kbd class="kbd">⌘</kbd><kbd class="kbd">K</kbd>
              </div>
              <p class="mn-d" style="margin:7px 0 0;text-align:center">命令面板</p>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="15" data-label="滑块 · slider" style="left:20%;top:70%">
          <div class="f-lev" style="--in-delay:1.01s;--lev-duration:6.7s;--lev-delay:1.05s">
            <article class="mini-card" style="--w:180px">
              <div class="mn-row mn-row--spread"><span class="mn-lb">音量</span><span class="mn-d" id="mc-slider-val">40</span></div>
              <div class="slider">
                <div class="slider-track"></div>
                <div class="slider-fill" style="width:40%"></div>
                <div class="slider-thumb" style="left:calc(40% - 8px)"></div>
                <input class="slider-native" type="range" min="0" max="100" value="40" aria-label="音量" />
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="12" data-label="加载 · spinner" style="left:42%;top:72%">
          <div class="f-lev" style="--in-delay:1.07s;--lev-duration:7.3s;--lev-delay:1.2s">
            <article class="mini-card" style="--w:130px">
              <div class="mn-row mn-row--center">
                <span class="spinner spinner--sm" aria-hidden="true"></span>
                <span class="mn-lb">构建中…</span>
              </div>
            </article>
          </div>
        </div>

        <div class="f-cell" data-depth="23" data-label="标签 · tag" style="left:64%;top:72%">
          <div class="f-lev" style="--in-delay:1.13s;--lev-duration:6s;--lev-delay:.9s">
            <article class="mini-card" style="--w:150px">
              <div class="mn-wrap">
                <span class="tag tag--sm"><span class="tag-label">设计系统</span></span>
                <span class="tag tag--sm tag--accent"><span class="tag-label">v{pkg.version}</span></span>
                <span class="tag tag--sm"><span class="tag-label">AI 原生</span></span>
              </div>
            </article>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ 预设换肤带：点击即换肤，全站零改动 ═══ -->
  <section class="presets-sec" aria-label="色彩预设">
    <div class="sec-head">
      <p class="sec-over"><span class="sec-over-dot" aria-hidden="true"></span>TOKENS · 三层正交</p>
      <h2 class="sec-title">一套 tokens，六副面孔</h2>
      <p class="sec-desc">色彩预设 × 明暗 × 风格 profile 互不耦合。点一张色板 —— 整站包括上面的每张卡片，即刻换肤。</p>
    </div>
    <div class="preset-grid" role="group" aria-label="切换色彩预设">
      {PRESET_SWATCHES.map((p) => (
        <button class="preset-chip" type="button" data-preset={p.id} aria-pressed="false">
          <span class="preset-check" aria-hidden="true"><Fragment set:html={presetCheckSvg} /></span>
          <span class="preset-dots" aria-hidden="true">
            <i style={`background:${p.bg}`}></i><i style={`background:${p.accent}`}></i><i style={`background:${p.cold}`}></i>
          </span>
          <span class="preset-name">{p.name}</span>
        </button>
      ))}
    </div>
    <p class="preset-hint">{COMPONENTS.length} 个组件共享同一套 <code>--token-*</code> —— 换肤不改一行组件代码。</p>
  </section>

  <!-- ═══ 特性 ═══ -->
  <section class="features-sec" aria-label="设计哲学">
    <div class="sec-head">
      <p class="sec-over"><span class="sec-over-dot" aria-hidden="true"></span>WHY · 设计哲学</p>
      <h2 class="sec-title">为下一个十年的界面而生</h2>
    </div>
    <div class="features">
      <div class="feature">
        <span class="feature-icon" aria-hidden="true"><Fragment set:html={featureIcons.ai} /></span>
        <h3 class="feature-title">AI 原生族</h3>
