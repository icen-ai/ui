---
import '../../../src/tokens/colors.css';
import '../../../src/tokens/style-profiles.css';
import '../../../src/tokens/typography.css';
import 'misans/lib/Normal/MiSansVF.min.css'; /* MiSans VF（150–700）56 片 unicode-range 分包，随构建自托管同源 */
import '../../../src/base.css';
import '../../../src/components/btn.css';
import '../../../src/components/pill.css';
import '../../../src/components/select.css';
import '../../../src/components/command-palette.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeRestore from '../components/ThemeRestore.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ICEN UI · 设计系统',
  description = 'ICEN UI（@icen.ai/ui）—— icen.ai 生态的统一设计系统：6 套色彩预设 × 明暗双模 × 无框架组件与行为 JS',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://ui.icen.ai').toString();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <ThemeRestore />
  </head>
  <body>
    <SiteHeader />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  .site-main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px 96px;
  }
</style>
