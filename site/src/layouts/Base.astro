---
import '../../../src/tokens/colors.css';
import '../../../src/tokens/style-profiles.css';
import '../../../src/tokens/typography.css';
import '../../../src/base.css';
import '../../../src/components/btn.css';
import '../../../src/components/pill.css';
import '../../../src/components/select.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ICEN UI · 设计系统',
  description = 'ICEN UI（@icen.ai/ui）—— icen.ai 生态的统一设计系统：6 套色彩预设 × 明暗双模 × 无框架组件与行为 JS',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://ui.icen.ai').toString();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline>
      // 防主题闪烁：首帧渲染前同步恢复 localStorage 中的 preset/style/dark 类。
      // 存储契约与 src/behaviors/theme.ts 一致：'icen.ui.theme' = {"preset","dark","style"}。
      (function () {
        try {
          var raw = localStorage.getItem('icen.ui.theme');
          var t = raw ? JSON.parse(raw) : null;
          var cl = document.documentElement.classList;
          if (t && typeof t === 'object') {
            if (typeof t.preset === 'string') cl.add(t.preset);
            if (t.dark === true) cl.add('dark');
            if (typeof t.style === 'string') cl.add('style-' + t.style);
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            cl.add('dark'); // 无持久化时跟随系统明暗（同 theme.ts 的默认行为）
          }
        } catch (e) { /* 坏数据时保持默认，initTheme 会兜底 */ }
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  .site-main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px 96px;
  }
</style>
