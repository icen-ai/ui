import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeRestore from '../components/ThemeRestore.astro';
import { ClientRouter } from 'astro:transitions';
import { COMPONENTS, GROUPS } from '../lib/components';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ICEN UI · 设计系统',
  description = 'ICEN UI（@icen.ai/ui）—— icen.ai 生态的统一设计系统：6 套色彩预设 × 明暗双模 × 无框架组件与行为 JS',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://ui.icen.ai').toString();
const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <ThemeRestore />
    {/* 文档域内客户端换页（组件↔原语↔色彩↔各组件页）：页头/页脚 transition:persist
        常驻，仅主区与侧栏换血；首页走 Base 布局无路由，进出仍整页加载（两套 CSS 集） */}
    <ClientRouter prefetch />
  </head>
  <body>
    <SiteHeader />
    <div class="docs-shell">
      <aside class="docs-side">
        <nav class="docs-nav" aria-label="文档导航">
          <details class="docs-group" data-group="开始">
            <summary class="docs-group-name">
              <span class="docs-group-title">开始</span>
              <span class="docs-group-count">3</span>
            </summary>
            <div class="docs-group-links">
              <a class:list={['docs-link', { active: path === '/' }]} href="/">介绍</a>
              <a class:list={['docs-link', { active: isActive('/primitives/') }]} href="/primitives/">原语</a>
              <a class:list={['docs-link', { active: isActive('/tokens/') }]} href="/tokens/">色彩 Tokens</a>
            </div>
          </details>
          {GROUPS.map((g) => {
            const items = COMPONENTS.filter((c) => c.group === g);
            return (
              <details class="docs-group" data-group={g}>
                <summary class="docs-group-name">
                  <span class="docs-group-title">{g}</span>
                  <span class="docs-group-count">{items.length}</span>
                </summary>
                <div class="docs-group-links">
                  {items.map((c) => (
                    <a
                      class:list={['docs-link', { active: isActive(`/components/${c.slug}/`) }]}
                      href={`/components/${c.slug}/`}
                    >{c.name}</a>
                  ))}
                </div>
              </details>
            );
          })}
        </nav>
      </aside>
      <script is:inline data-astro-rerun>
        /* 侧栏折叠 + 滚动位（首帧前同步完成，无闪烁）：
           ① 开组记忆住 window 内存——客户端换页（ClientRouter 同文档）保留手动
              展开/收起；真刷新即新文档、内存归零，回到「全收 + 深链开组」默认
           ② 每次换页确保当前页所在组展开（记忆 ∪ 当前组；当前组可被手动收起，
              下一跳再进该组重新展开）
           ③ 渐隐纯 CSS（scroll-timeline，见 site.css）；滚动位写 sessionStorage */
        (() => {
          var side = document.querySelector('.docs-side');
          if (!side) return;
          var groups = Array.prototype.slice.call(document.querySelectorAll('.docs-group[data-group]'));

          var memory = window.__docsNavOpen;
          if (!(memory instanceof Set)) memory = window.__docsNavOpen = new Set();

          var activeLink = document.querySelector('.docs-group[data-group] .docs-link.active');
          var activeGroup = activeLink ? activeLink.closest('.docs-group[data-group]') : null;
          /* 初始化即写回记忆（open=true 的 toggle 事件也会镜像进 Set，保持一致） */
          groups.forEach(function (d) { d.open = memory.has(d.getAttribute('data-group')) || d === activeGroup; });

          groups.forEach(function (d) {
            d.addEventListener('toggle', function () {
              if (d.open) memory.add(d.getAttribute('data-group'));
              else memory.delete(d.getAttribute('data-group'));
            });
          });

          var KEY = 'icen.docs.nav-scroll';
          var saved = sessionStorage.getItem(KEY);
          if (saved !== null) side.scrollTop = Number(saved) || 0;
          var raf = 0;
          side.addEventListener('scroll', function () {
            if (raf) return;
            raf = requestAnimationFrame(function () {
              raf = 0;
              sessionStorage.setItem(KEY, String(side.scrollTop));
            });
          }, { passive: true });
        })();
      </script>
      <main class="docs-main">
        <slot />
      </main>
    </div>
    <SiteFooter />
  </body>
</html>
