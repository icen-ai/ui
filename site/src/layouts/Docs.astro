---
import '../../../src/tokens/colors.css';
import '../../../src/tokens/style-profiles.css';
import '../../../src/tokens/typography.css';
import '../../../src/base.css';
import '../../../src/components/breadcrumb.css';
import '../../../src/components/btn.css';
import '../../../src/components/card.css';
import '../../../src/components/charts.css';
import '../../../src/components/content.css';
import '../../../src/components/empty.css';
import '../../../src/components/feedback.css';
import '../../../src/components/form.css';
import '../../../src/components/input.css';
import '../../../src/components/layout.css';
import '../../../src/components/media.css';
import '../../../src/components/menu.css';
import '../../../src/components/modal.css';
import '../../../src/components/nav.css';
import '../../../src/components/pagination.css';
import '../../../src/components/panel.css';
import '../../../src/components/pill.css';
import '../../../src/components/popover.css';
import '../../../src/components/segmented.css';
import '../../../src/components/select.css';
import '../../../src/components/sidebar.css';
import '../../../src/components/slider.css';
import '../../../src/components/stat.css';
import '../../../src/components/steps.css';
import '../../../src/components/switch.css';
import '../../../src/components/table.css';
import '../../../src/components/tabs.css';
import '../../../src/components/tag-input.css';
import '../../../src/components/toast.css';
import '../../../src/components/tooltip.css';
import '../../../src/components/upload.css';
import { COMPONENTS, GROUPS } from '../lib/components';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ICEN UI · 设计系统',
  description = 'ICEN UI（@icen.ai/ui）—— icen.ai 生态的统一设计系统：6 套色彩预设 × 明暗双模 × 无框架组件与行为 JS',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://ui.icen.ai').toString();
const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline>
      // 防主题闪烁：首帧渲染前同步恢复 localStorage 中的 preset/style/dark 类。
      // 存储契约与 src/behaviors/theme.ts 一致：'icen.ui.theme' = {"preset","dark","style"}。
      (function () {
        try {
          var raw = localStorage.getItem('icen.ui.theme');
          var t = raw ? JSON.parse(raw) : null;
          var cl = document.documentElement.classList;
          if (t && typeof t === 'object') {
            if (typeof t.preset === 'string') cl.add(t.preset);
            if (t.dark === true) cl.add('dark');
            if (typeof t.style === 'string') cl.add('style-' + t.style);
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            cl.add('dark'); // 无持久化时跟随系统明暗（同 theme.ts 的默认行为）
          }
        } catch (e) { /* 坏数据时保持默认，initTheme 会兜底 */ }
      })();
    </script>
  </head>
  <body>
    <header class="site-nav">
      <div class="site-nav-inner">
        <a class="brand" href="/">ICEN UI · 设计系统</a>
        <nav class="nav-links">
          <a href="/">首页</a>
          <a href="/primitives/">原语</a>
          <a href="/tokens/">色彩</a>
          <a href="/components/">组件</a>
          <a href="https://github.com/icen-ai/ui" target="_blank" rel="noopener">GitHub</a>
        </nav>
        <div class="nav-controls">
          <select id="preset-select" aria-label="色彩预设">
            <option value="clay">clay 陶土</option>
            <option value="piano">piano 钢琴</option>
            <option value="art">art 艺术</option>
            <option value="vangogh">vangogh 梵高</option>
            <option value="ink">ink 墨</option>
            <option value="retro">retro 复古</option>
          </select>
          <select id="style-select" aria-label="风格">
            <option value="modern">modern 现代</option>
            <option value="retro">retro 像素</option>
            <option value="terminal">terminal 终端</option>
          </select>
          <button id="dark-toggle" class="btn btn-sm" type="button">暗</button>
        </div>
      </div>
    </header>
    <div class="docs-shell">
      <aside class="docs-side">
        <nav class="docs-nav" aria-label="文档导航">
          <div class="docs-group">
            <p class="docs-group-name">开始</p>
            <a class:list={['docs-link', { active: path === '/' }]} href="/">介绍</a>
            <a class:list={['docs-link', { active: isActive('/primitives/') }]} href="/primitives/">原语</a>
            <a class:list={['docs-link', { active: isActive('/tokens/') }]} href="/tokens/">色彩 Tokens</a>
          </div>
          {GROUPS.map((g) => (
            <div class="docs-group">
              <p class="docs-group-name">{g}</p>
              {COMPONENTS.filter((c) => c.group === g).map((c) => (
                <a
                  class:list={['docs-link', { active: isActive(`/components/${c.slug}/`) }]}
                  href={`/components/${c.slug}/`}
                >{c.name}</a>
              ))}
            </div>
          ))}
        </nav>
      </aside>
      <main class="docs-main">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <div class="site-footer-inner">
        @icen.ai/ui — icen.ai 生态的统一设计系统 · 6 色彩预设 × 明暗双模 × 无框架组件
      </div>
    </footer>
    <script>
      import { initTheme, setTheme, toggleDark, type ThemeState } from '../../../src/behaviors/theme.ts';

      const presetSel = document.getElementById('preset-select') as HTMLSelectElement;
      const styleSel = document.getElementById('style-select') as HTMLSelectElement;
      const darkBtn = document.getElementById('dark-toggle') as HTMLButtonElement;

      function reflect(t: ThemeState): void {
        presetSel.value = t.preset;
        styleSel.value = t.style;
        darkBtn.textContent = t.dark ? '亮' : '暗';
      }

      reflect(initTheme());

      presetSel.addEventListener('change', () => reflect(setTheme({ preset: presetSel.value })));
      styleSel.addEventListener('change', () => reflect(setTheme({ style: styleSel.value })));
      darkBtn.addEventListener('click', () => reflect(toggleDark()));
    </script>
  </body>
</html>

<style is:global>
  /* ── 布局骨架：只用 --token-* / --font-* 设计变量（与 Base.astro 同套契约） ── */
  .site-nav {
    background: var(--token-surface);
    border-bottom: 1px solid var(--token-line-soft);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--token-text);
    letter-spacing: 1px;
  }
  .brand:hover { text-decoration: none; color: var(--token-accent); }
  .nav-links { display: flex; gap: 14px; }
  .nav-links a { color: var(--token-text-muted); font-size: 13px; }
  .nav-links a:hover { color: var(--token-accent); text-decoration: none; }
  .nav-controls { margin-left: auto; display: flex; align-items: center; gap: 8px; padding: 8px 0; }
  .nav-controls select {
    background: var(--token-bg);
    color: var(--token-text);
    border: 1px solid var(--token-line-soft);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 12px;
    padding: 5px 8px;
  }

  /* ── 文档分栏：左侧组件树 + 右侧正文 ── */
  .docs-shell {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
  }
  .docs-side {
    flex: 0 0 240px;
    width: 240px;
    position: sticky;
    top: 56px;
    max-height: calc(100vh - 56px);
    overflow-y: auto;
    border-right: 1px solid var(--token-line-soft);
    padding: 24px 14px 48px;
  }
  .docs-group { margin-bottom: 20px; }
  .docs-group-name {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--token-text-faint);
    margin: 0 0 6px;
    padding: 0 10px;
  }
  .docs-link {
    display: block;
    font-size: 13px;
    color: var(--token-text-muted);
    padding: 5px 10px 5px 12px;
    border-left: 2px solid transparent;
    margin-left: -1px;
  }
  .docs-link:hover { color: var(--token-accent); text-decoration: none; }
  .docs-link.active {
    color: var(--token-accent);
    font-weight: 500;
    border-left-color: var(--token-accent);
  }
  .docs-main {
    flex: 1;
    min-width: 0;
    max-width: 860px;
    padding: 36px 40px 72px;
  }

  .site-footer { border-top: 1px solid var(--token-line-soft); }
  .site-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    color: var(--token-text-faint);
    font-size: 12px;
    letter-spacing: 1px;
  }

  /* ── 演示辅助类（合集页.demo-* 约定搬进注册表 demo  markup） ── */
  .panel-body { padding: 18px 20px 22px; }
  .preview {
    border: 1px dashed var(--token-line-dashed);
    border-radius: var(--radius-sm);
    padding: 20px;
    margin: 14px 0;
  }
  .demo-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .demo-col { display: flex; flex-direction: column; gap: 12px; max-width: 380px; }
  .demo-col-wide { display: flex; flex-direction: column; gap: 10px; }
  .demo-sub { font-size: 13px; color: var(--token-text-muted); margin: 20px 0 10px; }
  .demo-logo {
    font-family: var(--font-heading); font-weight: 700; font-size: 14px;
    color: var(--token-accent); letter-spacing: 1px; padding: 0 4px;
  }
  .demo-box {
    background: var(--token-accent-subtle); border: 1px solid var(--token-outline-soft);
    border-radius: var(--radius-sm); padding: 8px 12px;
    font-size: 12px; color: var(--token-text-muted);
  }
  .demo-label { font-size: 11px; color: var(--token-text-faint); margin: 0; }
  .demo-fill { background: color-mix(in srgb, var(--token-accent) 30%, transparent); border-radius: var(--radius-sm); }
  .ctx-zone {
    display: flex; align-items: center; justify-content: center;
    min-height: 96px; padding: 16px;
    border: 1px dashed var(--token-line-dashed); border-radius: var(--radius-md);
    color: var(--token-text-muted); font-size: 13px; user-select: none;
  }
  .chart-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .chart-cap { margin: 0 0 8px; font-size: 12px; color: var(--token-text-muted); }

  /* ── 移动端：侧栏折叠成顶部横向 wrap 链接条 ── */
  @media (max-width: 859px) {
    .docs-shell { flex-direction: column; }
    .docs-side {
      position: static;
      flex: none;
      width: auto;
      max-height: none;
      overflow: visible;
      border-right: 0;
      border-bottom: 1px solid var(--token-line-soft);
      padding: 12px 16px;
    }
    .docs-group { margin-bottom: 10px; }
    .docs-group-name { padding: 0 6px; }
    .docs-group {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 2px;
    }
    .docs-group-name { flex: 0 0 100%; }
    .docs-link {
      border-left: 0;
      margin-left: 0;
      padding: 4px 6px;
      border-bottom: 2px solid transparent;
    }
    .docs-link.active { border-bottom-color: var(--token-accent); }
    .docs-main { padding: 24px 18px 56px; }
  }
</style>
