import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { COMPONENTS, GROUPS } from '../lib/components';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ICEN UI · 设计系统',
  description = 'ICEN UI（@icen.ai/ui）—— icen.ai 生态的统一设计系统：6 套色彩预设 × 明暗双模 × 无框架组件与行为 JS',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://ui.icen.ai').toString();
const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline>
      // 防主题闪烁：首帧渲染前同步恢复 localStorage 中的 preset/style/dark 类。
      // 存储契约与 src/behaviors/theme.ts 一致：'icen.ui.theme' = {"preset","dark","style"}。
      (function () {
        try {
          var raw = localStorage.getItem('icen.ui.theme');
          var t = raw ? JSON.parse(raw) : null;
          var cl = document.documentElement.classList;
          if (t && typeof t === 'object') {
            if (typeof t.preset === 'string') cl.add(t.preset);
            if (t.dark === true) cl.add('dark');
            if (typeof t.style === 'string') cl.add('style-' + t.style);
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            cl.add('dark'); // 无持久化时跟随系统明暗（同 theme.ts 的默认行为）
          }
        } catch (e) { /* 坏数据时保持默认，initTheme 会兜底 */ }
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <div class="docs-shell">
      <aside class="docs-side">
        <nav class="docs-nav" aria-label="文档导航">
          <div class="docs-group">
            <p class="docs-group-name">开始</p>
            <a class:list={['docs-link', { active: path === '/' }]} href="/">介绍</a>
            <a class:list={['docs-link', { active: isActive('/primitives/') }]} href="/primitives/">原语</a>
            <a class:list={['docs-link', { active: isActive('/tokens/') }]} href="/tokens/">色彩 Tokens</a>
          </div>
          {GROUPS.map((g) => {
            const items = COMPONENTS.filter((c) => c.group === g);
            return (
              <details class="docs-group" data-group={g} open>
                <summary class="docs-group-name">
                  <span class="docs-group-title">{g}</span>
                  <span class="docs-group-count">{items.length}</span>
                </summary>
                <div class="docs-group-links">
                  {items.map((c) => (
                    <a
                      class:list={['docs-link', { active: isActive(`/components/${c.slug}/`) }]}
                      href={`/components/${c.slug}/`}
                    >{c.name}</a>
                  ))}
                </div>
              </details>
            );
          })}
        </nav>
      </aside>
      <script is:inline>
        /* 分组折叠状态：details 天然多开；首访（无存储）全开；之后按记忆恢复；
           深链兜底——当前页所在组永远展开（toggle 自愈会把记忆里误存的折叠清掉）。
           本脚本在 </aside> 后同步执行，首帧绘制前完成，无闪烁。 */
        (() => {
          const KEY = 'icen.docs.nav.groups';
          const groups = Array.from(document.querySelectorAll('.docs-group[data-group]'));
          if (!groups.length) return;
          let collapsed = null;
          try { collapsed = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { collapsed = null; }
          if (!Array.isArray(collapsed)) { localStorage.setItem(KEY, '[]'); return; }
          const activeLink = document.querySelector('.docs-group[data-group] .docs-link.active');
          const activeGroup = activeLink ? activeLink.closest('.docs-group[data-group]') : null;
          groups.forEach(function (d) {
            d.open = collapsed.indexOf(d.getAttribute('data-group')) === -1;
          });
          if (activeGroup) activeGroup.open = true;
          groups.forEach(function (d) {
            d.addEventListener('toggle', function () {
              const name = d.getAttribute('data-group');
              if (!name) return;
              let cur = [];
              try { cur = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { cur = []; }
              const next = d.open ? cur.filter(function (x) { return x !== name; })
                                  : cur.concat([name]).filter(function (v, i, a) { return a.indexOf(v) === i; });
              localStorage.setItem(KEY, JSON.stringify(next));
            });
          });
        })();
      </script>
      <script is:inline>
        /* 侧栏滚动位置跨页保持（MPA 整页跳转不丢滚动位）：
           滚动时 rAF 节流写 sessionStorage；本脚本在 </aside> 后同步执行，
           首帧绘制前恢复 scrollTop，无闪烁。 */
        (() => {
          const KEY = 'icen.docs.nav-scroll';
          const scroller = document.querySelector('.docs-side');
          if (!scroller) return;
          const saved = sessionStorage.getItem(KEY);
          if (saved !== null) scroller.scrollTop = Number(saved) || 0;
          let raf = 0;
          scroller.addEventListener('scroll', () => {
            if (raf) return;
            raf = requestAnimationFrame(() => {
              raf = 0;
              sessionStorage.setItem(KEY, String(scroller.scrollTop));
            });
          }, { passive: true });
        })();
      </script>
      <main class="docs-main">
        <slot />
      </main>
    </div>
    <SiteFooter />
  </body>
</html>
