---
/*
 * 文档站代码展示 —— @icen.ai/ui code-block 组件（blog 同款）：
 * shiki 双主题高亮（构建期）→ codeBlockHTML 字符串渲染（figure.icen-code-block 全家：
 * 标题栏/行号开关/换行/折叠/复制），交互由 initCodeBlock 事件委托接管。
 * 暗色切换由组件 CSS 的 [data-icen-dual-theme] 钩子自动生效。
 */
import { shikiPre } from '../lib/highlight';
import { codeBlockHTML } from '../../../src/behaviors/code-block';

interface Props {
  code: string;
  lang?: string;
  file?: string;
  title?: string;
  /** 初始显示行号（缺省隐藏，与 blog 正文一致——读者可用工具钮开） */
  num?: boolean;
  /** 强制折叠为固定高度 + 底部渐隐（超阈值自动折叠不需要此开关） */
  collapsible?: boolean;
}
const { code, lang = 'bash', file, title, num = false, collapsible = false } = Astro.props;
const pre = await shikiPre(code, lang);
const html = codeBlockHTML({ html: pre, lang, file, title, num, fold: collapsible || undefined });
---
<Fragment set:html={html} />

<script>
  import { initCodeBlock } from '../../../src/behaviors/code-block';
  // 文档级事件委托、幂等；ClientRouter 客户端换页后 document 上的监听持续生效
  initCodeBlock();
</script>
