---
// 防主题闪烁：首帧渲染前同步恢复 localStorage 主题 data 属性（Base / Docs 共用；契约同 src/behaviors/theme.ts）。
---
<script is:inline>
  // 存储契约与 src/behaviors/theme.ts 一致：'icen.ui.theme' = {"preset","dark","style"}。
  (function () {
    try {
      var raw = localStorage.getItem('icen.ui.theme');
      var t = raw ? JSON.parse(raw) : null;
      var root = document.documentElement;
      if (t && typeof t === 'object') {
        if (typeof t.preset === 'string') root.setAttribute('data-icen-preset', t.preset);
        if (t.dark === true) root.setAttribute('data-icen-theme', 'dark');
        if (typeof t.style === 'string') root.setAttribute('data-icen-style', t.style);
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        root.setAttribute('data-icen-theme', 'dark'); // 无持久化时跟随系统明暗（同 theme.ts 的默认行为）
      }
    } catch (e) { /* 坏数据时保持默认，initTheme 会兜底 */ }
  })();
</script>
