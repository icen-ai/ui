---
// Restore palette + primitive before first paint; migrate removed style profiles.
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    var t = null;
    try { t = JSON.parse(localStorage.getItem('icen.ui.theme') || 'null'); } catch (_) {}
    var valid = t && typeof t === 'object' && typeof t.preset === 'string' && /^[a-z][a-z0-9-]{1,20}$/.test(t.preset) && t.preset !== 'dark' && !t.preset.startsWith('style-') && typeof t.dark === 'boolean';
    var preset = valid && t.preset !== 'retro' ? t.preset : 'benzhen';
    var dark = valid ? t.dark : window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.setAttribute('data-icen-preset', preset);
    var primitive = valid && t.style === 'pixel' ? 'pixel' : 'benzhen';
    root.setAttribute('data-icen-style', primitive);
    root.removeAttribute('data-icen-design');
    if (dark) root.setAttribute('data-icen-theme','dark');
    else root.removeAttribute('data-icen-theme');
    if (valid && (t.style !== primitive || t.preset !== preset)) {
      try { localStorage.setItem('icen.ui.theme',JSON.stringify({preset:preset,dark:dark,style:primitive})); } catch (_) {}
    }
  })();
</script>
