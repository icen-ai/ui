---
import mark from '../../public/favicon.svg?raw';
interface Props { size?: number; class?: string }
const { size = 24, class: className, ...attributes } = Astro.props;
// 内联标识与浏览器图标直接读取同一份、受版本控制的 SVG。
const content = mark.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg {...attributes} viewBox="0 0 64 64" width={size} height={size} class:list={['icen-brand-mark', className]} aria-hidden="true" focusable="false"><Fragment set:html={content} /></svg>
