---
import { themeSwitcherHTML } from '../../../src/behaviors/theme-switcher';
import { iconHTML } from '../../../src/behaviors/icons';
import { COMPONENTS, GROUPS } from '../lib/components';
import pkg from '../../../package.json';

const path = Astro.url.pathname;
const isActive = (href: string): boolean => path.startsWith(href);

/* 顶导右侧三个能力入口挂在组件树内的落地页上——active 归属按分组 slug 判定，
   避免与「组件」的 /components/ 前缀互相点亮；slug 清单同时喂给客户端换页脚本 */
const aiSlugs = COMPONENTS.filter((c) => c.group === 'AI 原生').map((c) => c.slug);
const chartSlugs = COMPONENTS.filter((c) => c.group === '图表').map((c) => c.slug);
const inSlugs = (slugs: string[]): boolean => slugs.some((s) => path.startsWith(`/components/${s}/`));
const componentsActive = path.startsWith('/components/') && !inSlugs(aiSlugs) && !inSlugs(chartSlugs);

// ⌘K 命令面板条目：顶层页面 + 全部组件（按分组）
const pages = [
  { name: '首页 · 介绍', slug: '', href: '/', kw: 'home intro 首页' },
  { name: '组件总览', slug: 'components', href: '/components/', kw: 'components 组件' },
  { name: '原语 · 交互基元', slug: 'primitives', href: '/primitives/', kw: 'primitives 原语' },
  { name: '主题', slug: 'tokens', href: '/tokens/', kw: 'tokens colors 色彩 预设' },
] as const;
const paletteGroups = GROUPS.map((g) => ({
  name: g,
  items: COMPONENTS.filter((c) => c.group === g),
})).filter((g) => g.items.length > 0);

const searchSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`;
const githubSvg = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.35.77 1.05.77 2.12v3.15c0 .3.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>`;
const snowArm = '<path d="M12 12V5.4"/><path d="M12 8.9 10.2 7"/><path d="M12 8.9 13.8 7"/><path d="M12 6.6 11.1 5.6"/><path d="M12 6.6 12.9 5.6"/>';
const snowArms = [0, 60, 120, 180, 240, 300].map((a) => '<g transform="rotate(' + a + ' 12 12)">' + snowArm + '</g>').join('');
/* 品牌雪花：accent 底方 + bg 色六臂雪花，随主题 accent 换色 */
const logoSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="1.5" y="1.5" width="21" height="21" rx="5.5" fill="var(--icen-token-accent)"/><g class="brand-flake" stroke="var(--icen-token-bg)" stroke-width="1.6" stroke-linecap="round">${snowArms}</g><circle cx="12" cy="12" r="1.3" fill="var(--icen-token-bg)"/></svg>`;
---
<header class="site-nav" transition:persist="site-nav">
  <div class="site-nav-inner">
    <a class="brand" href="/" aria-label="ICEN UI 首页">
      <Fragment set:html={logoSvg} />
      <span class="brand-name">ICEN UI</span>
      <span class="brand-ver" aria-hidden="true">v{pkg.version}</span>
    </a>
    <nav class="nav-links" aria-label="主导航" data-ai-slugs={aiSlugs.join(',')} data-chart-slugs={chartSlugs.join(',')}>
      <a data-nav="components" class:list={['nav-primary', { active: componentsActive }]} href="/components/">组件</a>
      <a class:list={[{ active: isActive('/tokens/') }]} href="/tokens/">色彩</a>
      <a class:list={[{ active: isActive('/primitives/') }]} href="/primitives/">原语</a>
      <a class:list={[{ active: isActive('/frameworks/') }]} href="/frameworks/">框架</a>
      <a class:list={[{ active: isActive('/customize/') }]} href="/customize/">定制</a>
      <span class="nav-links-sep" aria-hidden="true"></span>
      <a data-nav="ai" class:list={[{ active: inSlugs(aiSlugs) }]} href="/components/ai-overview/">AI 原生</a>
      <a class:list={[{ active: isActive('/kb/') }]} href="/kb/">知识库</a>
      <a data-nav="charts" class:list={[{ active: inSlugs(chartSlugs) }]} href="/components/charts/">数据图表</a>
      <span class="nav-ink" aria-hidden="true"></span>
    </nav>
    <div class="nav-controls">
      <button class="icen-nav-search" type="button" data-icen-command-palette-open="site-nav" title="搜索组件（⌘K）">
        <Fragment set:html={searchSvg} />
        <kbd class="nav-kbd">⌘K</kbd>
      </button>
      <span class="nav-sep" aria-hidden="true"></span>
      <!-- 外观：一个双色圆装下主题×原语×明暗（面板内三轴），配一枚直达明暗钮 -->
      <div id="appearance-select"><Fragment set:html={themeSwitcherHTML({kind:"all",display:"color",size:"sm"})} /></div>
      <div id="dark-toggle"><Fragment set:html={themeSwitcherHTML({kind:"mode",display:"icon",size:"sm"})} /></div>
      <!-- 语言切换：icen-select 契约（面板 behavior portal 到 body）。data-i18n-skip——
           语言名始终以各自语言呈现，不参与全站文案翻译 -->
      <div class="icen-select site-language-select" data-icen-select data-site-language data-i18n-skip data-icen-panel-min="120">
        <button class="icen-select-trigger icen-select-trigger--sm icen-pressable icen-focus-ring" type="button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="site-lang-label site-lang-value">
          <span class="icen-sr-only" id="site-lang-label">选择语言 / Choose language：</span>
          <span class="icen-select-leading" aria-hidden="true"><Fragment set:html={iconHTML('globe', { size: 14 })} /></span>
          <span class="icen-select-value" id="site-lang-value">中文</span>
        </button>
        <div class="icen-select-panel" hidden>
          <button class="icen-select-option" type="button" data-icen-value="zh-CN">中文</button>
          <button class="icen-select-option" type="button" data-icen-value="en-US">Eng</button>
        </div>
      </div>
      <a class="nav-icon-btn" href="https://github.com/icen-ai/ui" target="_blank" rel="noopener" aria-label="GitHub 仓库">
        <Fragment set:html={githubSvg} />
      </a>
    </div>
  </div>
</header>

<!-- ⌘K 全站搜索：命令面板（自家组件直出，条目 = 顶层页面 + 全部组件） -->
<div class="icen-command-palette-backdrop" data-icen-command-palette="site-nav" hidden>
  <div class="icen-command-palette">
    <div class="icen-command-palette-search">
      <span class="icen-command-palette-search-icon"><Fragment set:html={searchSvg} /></span>
      <input class="icen-command-palette-input" placeholder="搜索组件或页面…" />
      <kbd class="icen-command-palette-esc">ESC</kbd>
    </div>
    <div class="icen-command-palette-body">
      <div class="icen-command-palette-group">
        <p class="icen-command-palette-group-label">页面</p>
        {pages.map((p) => (
          <a class="icen-command-palette-item" href={p.href} data-icen-command-palette-keyword={p.kw}>
            <span class="icen-command-palette-item-label">{p.name}</span>
            <span class="icen-command-palette-item-hint">{p.href}</span>
          </a>
        ))}
      </div>
      {paletteGroups.map((g) => (
        <div class="icen-command-palette-group">
          <p class="icen-command-palette-group-label">{g.name}</p>
          {g.items.map((c) => (
            <a class="icen-command-palette-item" href={`/components/${c.slug}/`} data-icen-command-palette-keyword={`${c.slug} ${c.name}`}>
              <span class="icen-command-palette-item-label">{c.name}</span>
              <span class="icen-command-palette-item-hint">{c.slug}</span>
            </a>
          ))}
        </div>
      ))}
      <div class="icen-command-palette-empty" hidden>无匹配结果</div>
    </div>
    <div class="icen-command-palette-foot">
      <span class="icen-command-palette-foot-hint">
        <kbd>↑↓</kbd> 导航 <kbd>↵</kbd> 打开 <kbd>esc</kbd> 关闭
      </span>
    </div>
  </div>
</div>

<script>
  import { initTheme } from '../../../src/behaviors/theme';
  import { initThemeSwitcher } from '../../../src/behaviors/theme-switcher';
  import { initCommandPalette } from '../../../src/behaviors/command-palette';
  import { initSelect } from '../../../src/behaviors/select';
  import { initScrollArea } from '../../../src/behaviors/scroll-area';
  import { initSiteI18n, setSiteLanguage, type SiteLanguage } from '../lib/site-i18n';
  initTheme();
  let disposeScrollArea = initScrollArea();
  document.addEventListener('astro:before-swap', () => disposeScrollArea());
  document.addEventListener('astro:page-load', () => { disposeScrollArea(); disposeScrollArea = initScrollArea(); });
  initThemeSwitcher();
  initCommandPalette();
  initSelect(); // 先接线，initSiteI18n 里的 refreshSelect 才有实例可同步
  initSiteI18n();
  document.querySelector('[data-site-language]')?.addEventListener('icen:select-change', (event) => {
    setSiteLanguage((event as CustomEvent<{ value: SiteLanguage }>).detail.value);
  });
  document.addEventListener('astro:page-load', () => { initThemeSwitcher(); initSelect(); initSiteI18n(); });

  /* 导航墨条：hover 预览滑到悬停链接，离开回落到当前页；无 active（首页）时隐没。
     字体加载完成后重校一次，防 font-swap 移位。 */
  const navLinks = document.querySelector<HTMLElement>('.nav-links');
  const navInk = navLinks?.querySelector<HTMLElement>('.nav-ink');
  const placeInk = (target?: Element | null): void => {
    if (!navLinks || !navInk) return;
    const el = (target instanceof HTMLElement ? target : null) ?? navLinks.querySelector('a.active');
    if (!el || navLinks.offsetParent === null) {
      navInk.style.opacity = '0';
      return;
    }
    navInk.style.left = `${el.offsetLeft}px`;
    navInk.style.width = `${el.offsetWidth}px`;
    navInk.style.opacity = '1';
  };
  placeInk();
  document.fonts?.ready.then(() => placeInk()).catch(() => {});
  window.addEventListener('resize', () => placeInk(), { passive: true });
  navLinks?.querySelectorAll('a').forEach((a) => a.addEventListener('mouseenter', () => placeInk(a)));
  navLinks?.addEventListener('mouseleave', () => placeInk());

  /* 客户端换页（ClientRouter）：header 已 persist 常驻，这里手动对齐
     新页的 active 类（Astro 服务端算好的 active 在旧节点上），墨条顺势滑移 */
  document.addEventListener('astro:after-swap', () => {
    initTheme(); initThemeSwitcher(); // Restore persisted axes after ClientRouter replaces html attributes.
    const p = window.location.pathname;
    const aiSlugs = (navLinks?.dataset.aiSlugs ?? '').split(',').filter(Boolean);
    const chartSlugs = (navLinks?.dataset.chartSlugs ?? '').split(',').filter(Boolean);
    const inSlugs = (list: string[]): boolean => list.some((s) => p.startsWith(`/components/${s}/`));
    navLinks?.querySelectorAll('a').forEach((a) => {
      const href = a.getAttribute('href') ?? '/';
      const key = a.getAttribute('data-nav');
      const on =
        key === 'ai' ? inSlugs(aiSlugs)
        : key === 'charts' ? inSlugs(chartSlugs)
        : key === 'components' ? p.startsWith('/components/') && !inSlugs(aiSlugs) && !inSlugs(chartSlugs)
        : href === '/' ? p === '/' : p.startsWith(href);
      a.classList.toggle('active', on);
    });
    placeInk();
  });

  /* 滚动感应 hairline：页面顶端无界悬浮，滚过 8px 才显形分隔线并加深底色 */
  const siteNav = document.querySelector('.site-nav');
  const onScroll = (): void => siteNav?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
