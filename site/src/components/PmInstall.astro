---
import { shikiInner } from '../lib/highlight';
import { iconHTML } from '../../../src/behaviors/icons';

interface Props {
  pkg?: string;
}
const { pkg = '@icen.ai/ui' } = Astro.props;

const managers = [
  { id: 'bun', cmd: `bun add ${pkg}` },
  { id: 'pnpm', cmd: `pnpm add ${pkg}` },
  { id: 'npm', cmd: `npm install ${pkg}` },
  { id: 'yarn', cmd: `yarn add ${pkg}` },
];
const copySvg = iconHTML('copy');
const termSvg = iconHTML('terminal');
---
<div class="pm-install icen-copy-scope" data-icen-tabs>
  <div class="pm-head">
    <span class="pm-term" aria-hidden="true"><Fragment set:html={termSvg} /></span>
    <nav class="pm-tabs" aria-label="包管理器">
      {managers.map((m, i) => (
        <button
          class:list={['pm-tab', { 'is-active': i === 0 }]}
          type="button"
          data-icen-tab={m.id}
        >{m.id}</button>
      ))}
    </nav>
  </div>
  {await Promise.all(managers.map(async (m, i) => (
    <div class="pm-panel" data-icen-tab-panel={m.id} hidden={i !== 0}>
      <pre tabindex="0" role="region" aria-label={`${m.id} 安装命令`} data-icen-dual-theme><code set:html={await shikiInner(m.cmd, 'bash')} /></pre>
      <button class="icen-copy-btn icen-copy-btn--icon icen-copy-btn--ghost icen-copy-btn--quiet pm-copy" type="button" data-icen-copy={m.cmd} data-icen-copy-icon aria-label="复制命令">
        <Fragment set:html={copySvg} />
      </button>
    </div>
  )))}
</div>

<script>
  import { initTabs } from '../../../src/behaviors/tabs.ts';
  import { initCopy } from '../../../src/behaviors/copy.ts';
  // 立即初始化一次：首页走 Base 布局无 ClientRouter，astro:page-load 不会派发；
  // astro:page-load 监听保留给 Docs 布局——ClientRouter 换页后的新 DOM 需重 init。
  // initTabs/initCopy 均幂等，两处触发重复调用安全。
  const init = (): void => {
    initTabs();
    initCopy();
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
